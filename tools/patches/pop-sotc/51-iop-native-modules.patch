 endif()
 
+# Game IOP modules (IRX) recompiled to C++ by PoP's tools/iop/iop_recomp.py, placed in src/iop_generated/.
+# Optional; each registers with its module's file hash and load base and runs only with PS2X_IOP_NATIVE=1
+# (ps2x/iop/iop_native.h). Linked into the runner itself so the static registrations are kept.
+file(GLOB PS2X_IOP_GENERATED_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/iop_generated/*.cpp")
+if(PS2X_IOP_GENERATED_SOURCES)
+    target_sources(ps2EntryRunner PRIVATE ${PS2X_IOP_GENERATED_SOURCES})
+    set_source_files_properties(${PS2X_IOP_GENERATED_SOURCES} PROPERTIES
+        SKIP_UNITY_BUILD_INCLUSION TRUE
+        SKIP_PRECOMPILE_HEADERS TRUE)
+    if(MSVC)
+        set_source_files_properties(${PS2X_IOP_GENERATED_SOURCES} PROPERTIES COMPILE_OPTIONS "/bigobj;/W0")
+    endif()
