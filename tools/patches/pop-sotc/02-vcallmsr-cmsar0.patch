recomp: VCALLMSR reads CMSAR0 instead of out-of-bounds vi[27] (as upstream PR #268)

Part of the pop-sotc branch; see tools/ps2recomp-pop-sotc-branch.sh.

diff --git a/ps2xRecomp/src/lib/vu_translation_helpers.cpp b/ps2xRecomp/src/lib/vu_translation_helpers.cpp
index 0a030e8..eccbef4 100644
--- a/ps2xRecomp/src/lib/vu_translation_helpers.cpp
+++ b/ps2xRecomp/src/lib/vu_translation_helpers.cpp
@@ -203,17 +203,18 @@ namespace ps2recomp
 
     std::string CodeGenerator::translateVU_VCALLMSR(const Instruction &inst)
     {
-        // VCALLMSR calls a VU0 microprogram at address stored in integer register
-        uint8_t vis_reg_idx = inst.rd; // Source integer register (vis)
+        // VCALLMSR calls a VU0 microprogram at the address in CMSAR0. The encoding's
+        // register field is always 27 (vi27 = CMSAR0, a control register), so it must
+        // not index ctx->vi[], which only holds VI00-VI15.
+        (void)inst;
 
         return fmt::format(
             "{{ "
-            "    uint16_t instr_index = ctx->vi[{}] & 0x1FF; "             // Get instruction index from VI[IS], mask to 9 bits
+            "    uint16_t instr_index = ctx->vu0_cmsar0 & 0x1FF; "         // CMSAR0 holds an instruction index, mask to 9 bits
             "    uint32_t target_byte_addr = (uint32_t)instr_index << 3; " // Convert to byte address
             "    ctx->vu0_pc = target_byte_addr; "
             "    runtime->vu0StartMicroProgram(rdram, ctx, target_byte_addr); "
-            "}}",
-            vis_reg_idx);
+            "}}");
     }
 
     std::string CodeGenerator::translateVU_VRNEXT(const Instruction &inst)
