diff --git a/ps2xIOP/include/ps2x/iop/spu2_backend.h b/ps2xIOP/include/ps2x/iop/spu2_backend.h
new file mode 100644
index 0000000..eda8044
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/spu2_backend.h
@@ -0,0 +1,32 @@
+#pragma once
+// Another SPU2 behind the IOP's SPU2 registers and DMA (IopEmulator::setSpu2Backend): every register access, DMA and
+// time step the emulated SPU2 gets goes to it instead, and its output is the IOP's sound. pop-sotc uses it for
+// PCSX2's SPU2 core as the reference (PoP tools/iop/pcsx2_ref). Not in save states.
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <span>
+
+namespace ps2x::iop
+{
+    class Spu2Backend
+    {
+    public:
+        using AudioSink = std::function<void(std::span<const int16_t>)>; // 48 kHz stereo
+
+        virtual ~Spu2Backend() = default;
+        virtual void reset() = 0;
+        // Physical addresses 0x1F900000-0x1F9007FF (and the 0x1F900800+ shared registers); cycle: the IOP clock.
+        virtual uint16_t read16(uint32_t physicalAddress, uint64_t cycle) = 0;
+        virtual void write16(uint32_t physicalAddress, uint16_t value, uint64_t cycle) = 0;
+        // DMA channel 4 (core 0) / 7 (core 1): whether a write goes to the core's sound data input (AutoDMA), and
+        // the transfers, whole, at their start. The IOP's DMA completion is timed by the caller.
+        virtual bool autoDma(uint32_t core) const = 0;
+        virtual void dmaWrite(uint32_t core, const uint8_t *source, size_t bytes, uint64_t cycle) = 0;
+        virtual void dmaRead(uint32_t core, uint8_t *destination, size_t bytes, uint64_t cycle) = 0;
+        virtual void admaWrite(uint32_t core, const uint8_t *source, size_t bytes, uint64_t cycle) = 0;
+        // Mixes up to cycle and hands the output to sink.
+        virtual void advanceTo(uint64_t cycle, const AudioSink &sink) = 0;
+    };
+}
