+        const uint32_t shift = (setting >> 2u) & 0x1Fu, step = setting & 3u;
+        const bool decreasing = (setting & 0x2000u) != 0u, exponential = (setting & 0x4000u) != 0u,
+                   negative = (setting & 0x1000u) != 0u;
+        int32_t stepSize = 7 - static_cast<int32_t>(step);
+        if (decreasing)
+            stepSize = ~stepSize;
+        uint32_t increment = 0x8000u >> std::max(0, static_cast<int32_t>(shift) - 11);
+        int32_t delta = stepSize * (1 << std::max(0, 11 - static_cast<int32_t>(shift)));
