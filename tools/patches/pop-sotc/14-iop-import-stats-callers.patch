From fd38eb22697fb2cf03f55b00d79ddcd43a7ec38e Mon Sep 17 00:00:00 2001
From: Jon <resands@proton.me>
Date: Tue, 13 Oct 2026 19:47:02 +0100
Subject: [PATCH] IOP import stats: GetThreadId and WaitSema counted per caller
 (ra)

---
 ps2xIOP/src/emulator/iop_emulator.cpp | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index 89e92e1..2131532 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -263,12 +263,20 @@ namespace ps2x::iop::detail
         // the ones this emulator does not implement marked (they return with v0 unchanged).
         std::map<std::string, std::pair<uint64_t, bool>> importStats;
         uint64_t importStatsNext = 0;
-        void noteImportCall(const IopImportCall &call, ImportDisposition disposition)
+        void noteImportCall(const IopImportCall &call, ImportDisposition disposition, const CpuState &cpu)
         {
             static const bool on = [] { const char *v = std::getenv("PS2X_IOP_IMPORT_STATS"); return v && *v == '1'; }();
             if (!on)
                 return;
-            auto &entry = importStats[call.library + "#" + std::to_string(call.ordinal)];
+            std::string key = call.library + "#" + std::to_string(call.ordinal);
+            // Hot thread/semaphore imports also by caller, to find busy loops.
+            if ((call.library == "thbase" && call.ordinal == 20u) || (call.library == "thsemap" && call.ordinal == 8u))
+            {
+                char ra[16];
+                std::snprintf(ra, sizeof(ra), "@%x", cpu.gpr[31]);
+                key += ra;
+            }
+            auto &entry = importStats[key];
             ++entry.first;
             entry.second = entry.second || disposition == ImportDisposition::Missing;
             if (totalCycles < importStatsNext)
@@ -446,7 +454,7 @@ namespace ps2x::iop::detail
             if (const auto import = imports.decode(cpu.pc))
             {
                 const ImportDisposition disposition = dispatchImport(*import, cpu);
-                noteImportCall(*import, disposition);
+                noteImportCall(*import, disposition, cpu);
                 ++totalInstructions;
                 ++totalCycles;
                 if (disposition == ImportDisposition::JumpToGuest)
-- 
