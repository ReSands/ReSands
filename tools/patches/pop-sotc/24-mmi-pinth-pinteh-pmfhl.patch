From 45234daaba1477e7271a883111cf4b8ece4a352b Mon Sep 17 00:00:00 2001
From: Jon <resands@proton.me>
Date: Wed, 14 Oct 2026 12:00:43 +0100
Subject: [PATCH] MMI: PINTH/PINTEH interleave the right halfwords; PMFHL reads
 all 128 bits of HI/LO in every format

Found by an instruction-level test against the EE semantics (Prince of Persia project, tools/mmitest). PMFHL treated HI/LO as single 64-bit values, so LW/UW/SLW/LH/SH all mixed up words; PINTH took rs's low halfwords instead of its upper ones; PINTEH interleaved the upper halves instead of the even halfwords.
---
 .../src/lib/mmi_translation_helpers.cpp       | 10 ++--
 ps2xRuntime/include/ps2_runtime_macros.h      | 57 ++++++++++++++++---
 2 files changed, 55 insertions(+), 12 deletions(-)

diff --git a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
index 528102a..9dd1cb6 100644
--- a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
+++ b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
@@ -228,15 +228,15 @@ namespace ps2recomp
         switch (subfunc)
         {
         case PMFHL_LW:
-            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_LW(ctx->hi, ctx->lo));", inst.rd);
+            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_LW(ctx));", inst.rd);
         case PMFHL_UW:
-            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_UW(ctx->hi, ctx->lo));", inst.rd);
+            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_UW(ctx));", inst.rd);
         case PMFHL_SLW:
-            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_SLW(ctx->hi, ctx->lo));", inst.rd);
+            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_SLW(ctx));", inst.rd);
         case PMFHL_LH:
-            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_LH(ctx->hi, ctx->lo));", inst.rd);
+            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_LH(ctx));", inst.rd);
         case PMFHL_SH:
-            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_SH(ctx->hi, ctx->lo));", inst.rd);
+            return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PMFHL_SH(ctx));", inst.rd);
         default:
             return emitUnhandledInstruction(inst, fmt::format("Unhandled PMFHL instruction: function 0x{:X}", subfunc));
         }
diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index e3294fb..c839b3f 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -723,8 +723,9 @@ inline __m128i ps2_ppacb(__m128i rs, __m128i rt)
 #define PS2_PPACB(a, b) ps2_ppacb((__m128i)(a), (__m128i)(b))
 
 // Packed Interleave (PINT)
-#define PS2_PINTH(a, b) _mm_unpacklo_epi16(_mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(3, 2, 1, 0)), _mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(3, 2, 1, 0)))
-#define PS2_PINTEH(a, b) _mm_unpackhi_epi16(_mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(3, 2, 1, 0)), _mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(3, 2, 1, 0)))
+// PINTH: rd.h[2i] = rt.h[i], rd.h[2i+1] = rs.h[4+i]. PINTEH: rd.h[2i] = rt.h[2i], rd.h[2i+1] = rs.h[2i].
+#define PS2_PINTH(a, b) _mm_unpacklo_epi16((__m128i)(b), _mm_srli_si128((__m128i)(a), 8))
+#define PS2_PINTEH(a, b) _mm_or_si128(_mm_and_si128((__m128i)(b), _mm_set1_epi32(0xFFFF)), _mm_slli_epi32((__m128i)(a), 16))
 
 // Packed Multiply-Add (PMADD)
 #define PS2_PMADDW(a, b) _mm_add_epi32(_mm_mullo_epi32(_mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(1, 0, 3, 2)), _mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(1, 0, 3, 2))), _mm_mullo_epi32(_mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(3, 2, 1, 0)), _mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(3, 2, 1, 0))))
@@ -768,11 +769,53 @@ inline __m128i ps2_u64_to_epi64_pair(uint64_t value)
     return _mm_set1_epi64x(static_cast<long long>(value));
 }
 
-#define PS2_PMFHL_LW(hi, lo) _mm_unpacklo_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_UW(hi, lo) _mm_unpackhi_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_SLW(hi, lo) _mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_LH(hi, lo) _mm_shuffle_epi32(_mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi)), _MM_SHUFFLE(3, 1, 2, 0))
-#define PS2_PMFHL_SH(hi, lo) _mm_shufflehi_epi16(_mm_shufflelo_epi16(_mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi)), _MM_SHUFFLE(3, 1, 2, 0)), _MM_SHUFFLE(3, 1, 2, 0))
+// PMFHL: HI and LO are 128 bits ({lo, lo1}, {hi, hi1}).
+inline __m128i ps2_pmfhl(int fmt, uint64_t hi0, uint64_t hi1, uint64_t lo0, uint64_t lo1)
+{
+    const uint32_t lo[4] = {(uint32_t)lo0, (uint32_t)(lo0 >> 32), (uint32_t)lo1, (uint32_t)(lo1 >> 32)};
+    const uint32_t hi[4] = {(uint32_t)hi0, (uint32_t)(hi0 >> 32), (uint32_t)hi1, (uint32_t)(hi1 >> 32)};
+    auto sat16 = [](int32_t v) { return (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v); };
+    alignas(16) uint32_t w[4];
+    alignas(16) int16_t h[8];
+    switch (fmt)
+    {
+    case 0: // LW
+        w[0] = lo[0]; w[1] = hi[0]; w[2] = lo[2]; w[3] = hi[2];
+        break;
+    case 1: // UW
+        w[0] = lo[1]; w[1] = hi[1]; w[2] = lo[3]; w[3] = hi[3];
+        break;
+    case 2: // SLW: HI:LO word pairs saturated to 32 bits, sign-extended to each doubleword
+        for (int k = 0; k < 2; ++k)
+        {
+            const int64_t v = (int64_t)(((uint64_t)hi[2 * k] << 32) | lo[2 * k]);
+            const int64_t c = v > INT32_MAX ? INT32_MAX : v < INT32_MIN ? INT32_MIN : v;
+            w[2 * k] = (uint32_t)c;
+            w[2 * k + 1] = (uint32_t)((uint64_t)c >> 32);
+        }
+        break;
+    case 3: // LH
+    {
+        const uint32_t src[8] = {lo[0], lo[1], hi[0], hi[1], lo[2], lo[3], hi[2], hi[3]};
+        for (int i = 0; i < 8; ++i)
+            h[i] = (int16_t)src[i];
+        return _mm_load_si128((const __m128i *)h);
+    }
+    default: // SH
+    {
+        const uint32_t src[8] = {lo[0], lo[1], hi[0], hi[1], lo[2], lo[3], hi[2], hi[3]};
+        for (int i = 0; i < 8; ++i)
+            h[i] = sat16((int32_t)src[i]);
+        return _mm_load_si128((const __m128i *)h);
+    }
+    }
+    return _mm_load_si128((const __m128i *)w);
+}
+#define PS2_PMFHL_LW(ctx) ps2_pmfhl(0, (ctx)->hi, (ctx)->hi1, (ctx)->lo, (ctx)->lo1)
+#define PS2_PMFHL_UW(ctx) ps2_pmfhl(1, (ctx)->hi, (ctx)->hi1, (ctx)->lo, (ctx)->lo1)
+#define PS2_PMFHL_SLW(ctx) ps2_pmfhl(2, (ctx)->hi, (ctx)->hi1, (ctx)->lo, (ctx)->lo1)
+#define PS2_PMFHL_LH(ctx) ps2_pmfhl(3, (ctx)->hi, (ctx)->hi1, (ctx)->lo, (ctx)->lo1)
+#define PS2_PMFHL_SH(ctx) ps2_pmfhl(4, (ctx)->hi, (ctx)->hi1, (ctx)->lo, (ctx)->lo1)
 
 // FPU (COP1) operations
 #define FPU_SET_ACC(ctx, res) (ctx->f_acc = res)
-- 
