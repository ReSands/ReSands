+        return m_groups[group].input.playing;
+    }
+    uint32_t NativeMixer::inputOffset(int group) const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return inputOffsetOf(m_groups[group].input.position);
+    }
+    void NativeMixer::setInputHalfCallback(std::function<void(int group, int half)> half)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_inputHalf = std::move(half);
+    }
+
+    void NativeMixer::decode(Voice &voice)
+    {
+        const uint8_t *block = &m_memory[voice.block & (kSoundMemory - 16u)];
+        uint32_t shift = block[0] & 0xFu, filter = (block[0] >> 4u) & 7u;
+        if (shift > 12u)
+            shift = 9u;
+        if (filter > 4u)
+            filter = 4u;
+        voice.flags = block[1];
+        if ((voice.flags & 4u) != 0u && !voice.loopSet)
+            voice.loop = voice.block;
+        voice.samples[0] = voice.samples[28];
+        voice.samples[1] = voice.samples[29];
+        voice.samples[2] = voice.samples[30];
+        int32_t h0 = voice.history[0], h1 = voice.history[1];
+        for (uint32_t i = 0; i < 28u; ++i)
+        {
+            const uint32_t nibble = (block[2u + (i >> 1u)] >> ((i & 1u) * 4u)) & 0xFu;
+            int32_t value = static_cast<int16_t>(static_cast<uint16_t>(nibble << 12u)) >> shift;
+            value = clamp16(value + ((h0 * kFilterPositive[filter] + h1 * kFilterNegative[filter] + 32) >> 6));
+            h1 = h0;
+            h0 = value;
+            voice.samples[3u + i] = static_cast<int16_t>(value);
+        }
+        voice.history[0] = h0;
+        voice.history[1] = h1;
+    }
+
+    void NativeMixer::stepEnvelope(Voice &voice)
+    {
+        const uint16_t a1 = voice.adsr[0], a2 = voice.adsr[1];
+        switch (voice.phase)
+        {
+        case Voice::Phase::Attack:
+            envelopeStep(voice.level, voice.envelopeCounter, (a1 >> 8u) & 0x7Fu, false, (a1 & 0x8000u) != 0u);
+            if (voice.level >= 0x7FFF)
+            {
+                voice.phase = Voice::Phase::Decay;
+                voice.envelopeCounter = 0u;
+            }
+            break;
+        case Voice::Phase::Decay:
+            envelopeStep(voice.level, voice.envelopeCounter, ((a1 >> 4u) & 0xFu) << 2u, true, true);
+            if (voice.level <= std::min<int32_t>(((a1 & 0xFu) + 1) * 0x800, 0x7FFF))
+            {
+                voice.phase = Voice::Phase::Sustain;
+                voice.envelopeCounter = 0u;
+            }
+            break;
+        case Voice::Phase::Sustain:
+            envelopeStep(voice.level, voice.envelopeCounter, (a2 >> 6u) & 0x7Fu, (a2 & 0x4000u) != 0u, (a2 & 0x8000u) != 0u);
+            break;
+        case Voice::Phase::Release:
+            envelopeStep(voice.level, voice.envelopeCounter, (a2 & 0x1Fu) << 2u, true, (a2 & 0x20u) != 0u);
+            if (voice.level <= 0)
+            {
+                voice.level = 0;
+                voice.phase = Voice::Phase::Off;
+            }
+            break;
+        case Voice::Phase::Off:
+            break;
+        }
+    }
+
+    int32_t NativeMixer::sample(Group &group, int index, Voice &voice)
+    {
+        const uint32_t at = voice.counter >> 12u;
+        int32_t value = interpolate(voice.samples[at], voice.samples[at + 1u], voice.samples[at + 2u], voice.samples[at + 3u],
+                                    voice.counter & 0xFFFu);
+        stepEnvelope(voice);
+        value = mul15(value, voice.level);
+        voice.counter += std::min<uint32_t>(voice.pitch, 0x3FFFu);
+        while ((voice.counter >> 12u) >= 28u)
+        {
+            voice.counter -= 28u << 12u;
+            if ((voice.flags & 1u) != 0u)
+            {
+                // The block ends the sample: on to the loop point; without the repeat flag the voice stops.
+                group.ended |= 1u << index;
+                voice.block = voice.loop;
+                if ((voice.flags & 2u) == 0u)
+                {
+                    voice.phase = Voice::Phase::Off;
+                    voice.level = 0;
+                }
+            }
+            else
+                voice.block = (voice.block + 16u) & (kSoundMemory - 1u);
+            decode(voice);
+        }
+        return value;
+    }
+
+    void NativeMixer::report()
+    {
+        static const bool s_stats = [] { const char *v = std::getenv("PS2X_NATIVE_AUDIO_STATS"); return !(v && *v == '0'); }();
+        if (!s_stats)
+            return;
+        int playing = 0;
+        Stats stats;
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            for (const Group &group : m_groups)
+                for (const Voice &voice : group.voices)
+                    playing += voice.phase != Voice::Phase::Off ? 1 : 0;
+            stats = m_stats;
+            m_stats.peak = 0;
+        }
+        std::fprintf(stderr, "[audio] native mixer: %.0f s mixed, key ons %llu, uploaded %llu bytes, input halves %llu, peak %d, voices playing %d\n",
+                     static_cast<double>(stats.frames) / kSampleRate, static_cast<unsigned long long>(stats.keyOns),
+                     static_cast<unsigned long long>(stats.uploaded), static_cast<unsigned long long>(stats.halves), stats.peak,
+                     playing);
+        // Each group's input: its raw peak since the last line (the data the game streams), volume and mix switches.
+        for (int g = 0; g < kGroups; ++g)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            const Group &group = m_groups[g];
+            std::fprintf(stderr, "[audio]   group %d input %s raw peak %d volume %04x %04x mix %04x\n", g,
+                         group.input.playing ? "playing" : "stopped", g_inputRawPeak[g], static_cast<uint16_t>(group.input.volume[0]),
+                         static_cast<uint16_t>(group.input.volume[1]), group.mix);
+            g_inputRawPeak[g] = 0;
+        }
+    }
+
+    void NativeMixer::render(int16_t *out, size_t frames)
+    {
+        bool due = false;
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            const uint64_t before = m_stats.frames;
+            m_stats.frames += frames;
+            due = before / (10u * kSampleRate) != m_stats.frames / (10u * kSampleRate);
+            mix(out, frames);
+        }
+        if (due)
+            report();
+    }
+
+    void NativeMixer::mix(int16_t *out, size_t frames)
+    {
+        for (size_t frame = 0; frame < frames; ++frame)
+        {
+            // Group 0's output goes into group 1 (as its external input, through group 1's master volume).
+            int32_t mixed[2] = {0, 0};
+            for (int g = 0; g < kGroups; ++g)
+            {
+                Group &group = m_groups[g];
+                int32_t dry[2] = {0, 0}, wet[2] = {0, 0};
+                int32_t input[2] = {0, 0};
+                if (group.input.playing)
+                {
+                    Input &in = group.input;
+                    const uint32_t at = inputOffsetOf(in.position);
+                    for (int side = 0; side < 2; ++side)
+                    {
+                        const uint8_t *p = in.memory + at + static_cast<uint32_t>(side) * 512u;
+                        int16_t raw = static_cast<int16_t>(static_cast<uint16_t>(p[0] | (p[1] << 8u)));
+                        g_inputRawPeak[g] = std::max(g_inputRawPeak[g], std::abs(static_cast<int>(raw)));
+                        input[side] = mul15(raw, in.volume[side]);
+                    }
+                    ++in.position;
+                    const uint32_t half = in.samples / 2u;
+                    if (in.position == half || in.position >= in.samples)
+                    {
+                        const int which = in.position == half ? 0 : 1;
+                        if (in.position >= in.samples)
+                        {
+                            in.position = 0u;
+                            in.playing = in.loop;
+                        }
+                        ++m_stats.halves;
+                        // PS2X_NATIVE_AUDIO_INPUT_DUMP=<file> (diagnosis): each half of the input just played, as the
+                        // game left it in its buffer, appended in order.
+                        static std::FILE *s_dump = []
+                        {
+                            const char *path = std::getenv("PS2X_NATIVE_AUDIO_INPUT_DUMP");
+                            return path && *path ? std::fopen(path, "wb") : nullptr;
+                        }();
+                        if (s_dump)
+                        {
+                            const uint32_t bytes = half / 256u * 1024u;
+                            std::fwrite(in.memory + (which == 0 ? 0u : bytes), 1, bytes, s_dump);
+                            std::fflush(s_dump);
+                        }
+                        if (m_inputHalf)
+                            m_inputHalf(g, which);
+                    }
+                }
+                for (int index = 0; index < kVoices; ++index)
+                {
+                    Voice &voice = group.voices[index];
+                    voice.volume[0].tick();
+                    voice.volume[1].tick();
+                    if (voice.phase == Voice::Phase::Off)
+                        continue;
+                    const int32_t value = sample(group, index, voice);
+                    const uint32_t bit = 1u << index;
+                    if ((group.dry[0] & bit) != 0u)
+                        dry[0] += mul15(value, voice.volume[0].level);
+                    if ((group.dry[1] & bit) != 0u)
+                        dry[1] += mul15(value, voice.volume[1].level);
+                    if ((group.wet[0] & bit) != 0u)
+                        wet[0] += mul15(value, voice.volume[0].level);
+                    if ((group.wet[1] & bit) != 0u)
+                        wet[1] += mul15(value, voice.volume[1].level);
+                }
+                // The reverb: the send averaged over two output samples, a step every other sample, its output
+                // eased between steps; at the group's effect volume.
+                int32_t returned[2] = {0, 0};
+                Reverb &reverb = group.reverb;
+                group.effect[0].tick();
+                group.effect[1].tick();
+                if (reverb.enabled && reverb.mode != 0)
+                {
+                    int32_t send[2] = {clamp16(wet[0]), clamp16(wet[1])};
+                    if ((group.mix & 0x200u) == 0u)
+                        send[0] = 0;
+                    if ((group.mix & 0x100u) == 0u)
+                        send[1] = 0;
+                    send[0] += (group.mix & 0x20u) != 0u ? input[0] : 0;
+                    send[1] += (group.mix & 0x10u) != 0u ? input[1] : 0;
+                    if (g == 1)
+                    {
+                        send[0] += (group.mix & 0x2u) != 0u ? mixed[0] : 0;
+                        send[1] += (group.mix & 0x1u) != 0u ? mixed[1] : 0;
+                    }
+                    send[0] = clamp16(send[0]);
+                    send[1] = clamp16(send[1]);
+                    if (reverb.phase)
+                    {
+                        const int32_t average[2] = {(reverb.input[0] + send[0]) >> 1, (reverb.input[1] + send[1]) >> 1};
+                        reverb.previous[0] = reverb.out[0];
+                        reverb.previous[1] = reverb.out[1];
+                        stepReverb(reverb, average, reverb.out);
+                    }
+                    else
+                    {
+                        reverb.input[0] = send[0];
+                        reverb.input[1] = send[1];
+                    }
+                    for (int side = 0; side < 2; ++side)
+                    {
+                        const int32_t value = reverb.phase ? (reverb.previous[side] + reverb.out[side]) >> 1 : reverb.out[side];
+                        returned[side] = mul15(value, group.effect[side].level);
+                    }
+                    reverb.phase = !reverb.phase;
+                }
+                group.master[0].tick();
+                group.master[1].tick();
+                for (int side = 0; side < 2; ++side)
+                {
+                    // The dry switches: the voices (bits 11 / 10, left / right), the input (7 / 6), group 0 (3 / 2).
+                    const uint32_t shift = side == 0 ? 1u : 0u;
+                    int32_t level = returned[side];
+                    if ((group.mix & (0x400u << shift)) != 0u)
+                        level += clamp16(dry[side]);
+                    if ((group.mix & (0x40u << shift)) != 0u)
+                        level += input[side];
+                    level = clamp16(level);
+                    if (g == 0)
+                        mixed[side] = mul15(level, group.master[side].level);
+                    else
+                        mixed[side] = clamp16(((group.mix & (0x4u << shift)) != 0u ? mixed[side] : 0) + level);
+                }
+                if (g == kGroups - 1)
+                    for (int side = 0; side < 2; ++side)
+                        mixed[side] = mul15(mixed[side], group.master[side].level);
+            }
+            out[frame * 2u] = static_cast<int16_t>(clamp16(mixed[0]));
+            out[frame * 2u + 1u] = static_cast<int16_t>(clamp16(mixed[1]));
+            m_stats.peak = std::max({m_stats.peak, std::abs(clamp16(mixed[0])), std::abs(clamp16(mixed[1]))});
+        }
+    }
+}
diff --git a/ps2xIOP/src/emulator/devices/iop_native_mixer.h b/ps2xIOP/src/emulator/devices/iop_native_mixer.h
new file mode 100644
index 0000000..078fd7d
--- /dev/null
+++ b/ps2xIOP/src/emulator/devices/iop_native_mixer.h
@@ -0,0 +1,180 @@
+#pragma once
+// From TheBozos/PS2Recomp native/gs-backend (ps2xIOP/src/native_mixer.h, GPL-3.0); pop-sotc: an IOP device owned by
+// the emulator (no singleton), rendered by IOP time like the SPU2 it replaces; movie input removed (not wired in
+// this runtime).
+
+// Native sound playback for ports whose sound drivers are taken over at their API (libsd: native_libsd.cpp): the
+// game's sample banks (PS2 ADPCM, as its drivers upload them) played by 48 voices (two groups of 24, as the drivers
+// address them) with their pitch, ADSR envelope and volume, mixed at 48 kHz for the PC's audio device. There is no
+// sound chip here: no registers, no DMA, no interrupts, no chip timing. What a driver sets is a voice's playback
+// state, what it reads back (a voice's envelope, which voices reached their end) is that state as it plays.
+//
+// Reverb: each group's effect send through libsd's reverb presets (room ... pipe, echo and delay with their delay
+// time and feedback), the reverb's delay lines in sound memory below the effect end address as the drivers place
+// them, at 24 kHz as on the console, mixed back at the group's effect volume.
+//
+// The sound data input: a driver's PCM stream (sceSdBlockTrans) played from its buffer in IOP memory, 16-bit stereo at
+// 48 kHz in blocks of 256 left samples then 256 right, looping or once, with a signal at each half for the driver to
+// refill the other. Each group's mix (MMIX) routes the voices, the input and (group 1) group 0's output to the output
+// and the reverb.
+//
+// Not done yet: noise, pitch modulation.
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <vector>
+
+namespace ps2x::audio
+{
+    class NativeMixer
+    {
+    public:
+        static constexpr uint32_t kSoundMemory = 2u * 1024u * 1024u; // bytes
+        static constexpr uint32_t kSampleRate = 48000u;
+        static constexpr int kGroups = 2, kVoices = 24;
+
+        NativeMixer() { m_groups[1].mix = 0xFFCu; } // sceSdInit's mixes: group 1 also takes group 0's output (dry)
+
+        void reset();
+        // The drivers' uploads: bytes into sound memory at address.
+        void write(uint32_t address, const uint8_t *data, uint32_t bytes);
+        void read(uint32_t address, uint8_t *data, uint32_t bytes) const;
+
+        // A voice's playback settings, as libsd's voice parameters give them (volume: fixed when bit 15 is clear,
+        // value << 1 the level; pitch: 0x1000 plays a sample per 48 kHz output sample; ADSR: the PS2's two words).
+        void setVolume(int group, int voice, int side, uint16_t value);
+        void setPitch(int group, int voice, uint16_t pitch);
+        void setAdsr(int group, int voice, int word, uint16_t value);
+        void setStart(int group, int voice, uint32_t address);
+        void setLoop(int group, int voice, uint32_t address);
+        uint16_t volume(int group, int voice, int side) const;
+        uint16_t pitch(int group, int voice) const;
+        uint16_t adsr(int group, int voice, int word) const;
+        uint16_t envelope(int group, int voice) const; // the envelope's level now (0..0x7FFF)
+        uint32_t start(int group, int voice) const;
+        uint32_t loop(int group, int voice) const;
+        uint32_t position(int group, int voice) const; // the block playing now
+
+        // Key on / off (masks of the group's 24 voices); end: voices that reached a block with the end flag since
+        // their key on (the drivers poll it to free voices).
+        void keyOn(int group, uint32_t mask);
+        void keyOff(int group, uint32_t mask);
+        uint32_t ended(int group) const;
+        void clearEnded(int group, uint32_t mask);
+        // Which voices go to the output (left / right) and to the effect send (kept for reverb).
+        void setDryMask(int group, int side, uint32_t mask);
+        void setWetMask(int group, int side, uint32_t mask);
+        uint32_t dryMask(int group, int side) const;
+        uint32_t wetMask(int group, int side) const;
+        // A group's master and effect volumes (the volume encoding above).
+        void setMasterVolume(int group, int side, uint16_t value);
+        void setEffectVolume(int group, int side, uint16_t value);
+        uint16_t masterVolume(int group, int side) const;
+        uint16_t effectVolume(int group, int side) const;
+
+        // A group's reverb: mode 0 (off) .. 9 (pipe) as libsd numbers them; delay and feedback (0..127) for the echo
+        // and delay modes; end, the effect area's last byte in sound memory (the area is the mode's size below it).
+        void setEffect(int group, int mode, uint32_t delay, uint32_t feedback, uint32_t end);
+        void setEffectEnable(int group, bool enable);
+        // Zeroes the area mode's reverb uses below end.
+        void clearEffectArea(int mode, uint32_t end);
+        static uint32_t effectAreaBytes(int mode);
+
+        // A group's mix switches (MMIX: bits 0-3 group 0's output into group 1, 4-7 the input, 8-11 the voices; wet
+        // right, wet left, dry right, dry left) and its input volume (16-bit level).
+        void setMix(int group, uint16_t mix);
+        uint16_t mix(int group) const;
+        void setInputVolume(int group, int side, uint16_t value);
+        uint16_t inputVolume(int group, int side) const;
+        // The input: bytes at memory (a buffer in IOP RAM, which the driver refills while it plays) from offset; loop
+        // or once. half(group, half) is called (on the mixer's thread) each time a half has played, half 0 or 1.
+        void startInput(int group, const uint8_t *memory, uint32_t bytes, uint32_t offset, bool loop);
+        void stopInput(int group);
+        bool inputPlaying(int group) const;
+        uint32_t inputOffset(int group) const; // the byte the input plays next
+        void setInputHalfCallback(std::function<void(int group, int half)> half);
+
+        // frames stereo 16-bit samples at 48 kHz. Every 10 s of output (PS2X_NATIVE_AUDIO_STATS=0: never), a line on
+        // stderr: key ons, bytes uploaded, input halves played, the loudest sample, voices playing.
+        void render(int16_t *out, size_t frames);
+
+    private:
+        struct Volume
+        {
+            uint16_t setting = 0;
+            int32_t level = 0;
+            uint32_t counter = 0;
+            void set(uint16_t value);
+            void tick();
+        };
+        struct Voice
+        {
+            Volume volume[2];
+            uint16_t pitch = 0;
+            uint16_t adsr[2] = {};
+            uint32_t start = 0, loop = 0, block = 0;
+            bool loopSet = false;
+            enum class Phase : uint8_t
+            {
+                Off,
+                Attack,
+                Decay,
+                Sustain,
+                Release
+            } phase = Phase::Off;
+            int32_t level = 0;
+            uint32_t envelopeCounter = 0;
+            uint32_t counter = 0;      // 12-bit fraction of the position in the decoded block
+            uint8_t flags = 0;         // the block's flags (1 end, 2 repeat, 4 loop start)
+            int16_t samples[31] = {};  // 3 of the previous block, then the 28 of this one
+            int32_t history[2] = {};
+        };
+        struct Reverb
+        {
+            int mode = 0;
+            bool enabled = false;
+            uint16_t settings[32] = {}; // the preset's: dAPF1, dAPF2, vIIR ... mRAPF2, vLIN, vRIN (offsets in 8 bytes)
+            uint32_t start = 0, size = 0;  // the delay lines: first sample (16-bit units) and how many
+            uint32_t position = 0;
+            bool phase = false;            // the reverb steps every other output sample
+            int32_t input[2] = {}, out[2] = {}, previous[2] = {};
+        };
+        struct Input
+        {
+            const uint8_t *memory = nullptr;
+            uint32_t samples = 0, position = 0; // in stereo samples
+            bool playing = false, loop = false;
+            int16_t volume[2] = {0x7FFF, 0x7FFF};
+        };
+        struct Group
+        {
+            Voice voices[kVoices];
+            uint32_t ended = 0;
+            uint32_t dry[2] = {}, wet[2] = {};
+            Volume master[2], effect[2];
+            Reverb reverb;
+            uint16_t mix = 0xFF0u;
+            Input input;
+        };
+
+        void decode(Voice &voice);
+        void stepEnvelope(Voice &voice);
+        int32_t sample(Group &group, int index, Voice &voice);
+        void stepReverb(Reverb &reverb, const int32_t send[2], int32_t out[2]);
+
+        struct Stats
+        {
+            uint64_t frames = 0, keyOns = 0, uploaded = 0, halves = 0;
+            int32_t peak = 0;
+        } m_stats;
+        void report();
+        void mix(int16_t *out, size_t frames); // under m_mutex
+
+        mutable std::mutex m_mutex;
+        std::vector<uint8_t> m_memory = std::vector<uint8_t>(kSoundMemory, 0u);
+        Group m_groups[kGroups];
+        std::function<void(int group, int half)> m_inputHalf;
+    };
+}
