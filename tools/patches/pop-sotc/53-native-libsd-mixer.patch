@@ -1174,6 +1194,48 @@ namespace ps2x::iop::detail
         IopIoman ioman;
         IopSio2 sio2;
         IopSpu2 spu2;
+
+        // PS2X_NATIVE_AUDIO=1: libsd's calls go to the native mixer (imports/iop_libsd.h), which is rendered by IOP
+        // time here in place of the SPU2 (with PS2X_IOP_CLOCK=host, IOP time is real time).
+        const bool nativeAudio = []
+        {
+            const char *value = std::getenv("PS2X_NATIVE_AUDIO");
+            return value && *value == '1';
+        }();
+        ps2x::audio::NativeMixer mixer;
+        // libsd's transfer interrupts: guest calls function(a0, a1) due at a cycle. Not in states (see serialize).
+        std::multimap<uint64_t, std::array<uint32_t, 4>> libsdCalls;
+        IopLibsd libsd{memory, mixer, [this](uint32_t function, uint32_t a0, uint32_t a1, uint32_t gp)
+                       { libsdCalls.emplace(totalCycles + 2000u, std::array<uint32_t, 4>{function, a0, a1, gp}); }};
+        uint64_t mixerCycle = 0;
+        std::vector<int16_t> mixerOut;
+
+        void serviceLibsdCalls()
+        {
+            while (!libsdCalls.empty() && libsdCalls.begin()->first <= totalCycles)
+            {
+                const auto [function, a0, a1, gp] = libsdCalls.begin()->second;
+                libsdCalls.erase(libsdCalls.begin());
+                (void)callFunction(function, a0, a1, 0u, 0u, gp, 100000u);
+            }
+        }
+
+        void renderMixer()
+        {
+            constexpr uint64_t kCyclesPerFrame = kIopClockHz / ps2x::audio::NativeMixer::kSampleRate; // 768
+            const uint64_t frames = (totalCycles - mixerCycle) / kCyclesPerFrame;
+            if (frames == 0u)
+                return;
+            mixerCycle += frames * kCyclesPerFrame;
+            const size_t queued = mixerOut.size();
+            mixerOut.resize(queued + frames * 2u);
+            mixer.render(mixerOut.data() + queued, frames);
