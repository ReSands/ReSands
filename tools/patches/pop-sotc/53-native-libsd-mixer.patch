diff --git a/ps2xIOP/src/emulator/imports/iop_libsd.cpp b/ps2xIOP/src/emulator/imports/iop_libsd.cpp
new file mode 100644
index 0000000..beefe65
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_libsd.cpp
@@ -0,0 +1,459 @@
+// From TheBozos/PS2Recomp native/gs-backend (ps2xIOP/src/native_libsd.cpp, GPL-3.0); see iop_libsd.h.
+//
+// libsd's entries: a parameter, switch or address id | voice << 1 | core.
+#include "emulator/imports/iop_libsd.h"
+
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/devices/iop_native_mixer.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // Voice parameters.
+        constexpr uint32_t kVolL = 0x0000u, kVolR = 0x0100u, kPitch = 0x0200u, kAdsr1 = 0x0300u, kAdsr2 = 0x0400u,
+                           kEnvX = 0x0500u, kVolXL = 0x0600u, kVolXR = 0x0700u;
+        // Core parameters (bit 7 set).
+        constexpr uint32_t kMix = 0x0800u, kMVolL = 0x0980u, kMVolR = 0x0A80u, kEVolL = 0x0B80u, kEVolR = 0x0C80u,
+                           kBVolL = 0x0F80u, kBVolR = 0x1080u;
+        // Switches.
+        constexpr uint32_t kKon = 0x1500u, kKoff = 0x1600u, kEndX = 0x1700u, kVMixL = 0x1800u, kVMixEL = 0x1900u,
+                           kVMixR = 0x1A00u, kVMixER = 0x1B00u;
+        // Addresses.
+        constexpr uint32_t kEea = 0x1D00u, kTsa = 0x1E00u, kSsa = 0x2040u, kLsax = 0x2140u, kNax = 0x2240u;
+        // Core attributes.
+        constexpr uint32_t kEffectEnable = 0x2u;
+        // A transfer's end is reported this long after the call (IOP cycles), as libsd's DMA interrupt would.
+        constexpr uint32_t kTransferDoneDelay = 2000u;
+
+        int coreOf(uint32_t entry)
+        {
+            return static_cast<int>(entry & 1u);
+        }
+        int voiceOf(uint32_t entry)
+        {
+            return static_cast<int>((entry >> 1u) & 0x1Fu) % ps2x::audio::NativeMixer::kVoices;
+        }
+
+        // PS2X_NATIVE_AUDIO_LOG=1 (diagnosis): the first 200 switch, parameter and attribute calls.
+        bool logging()
+        {
+            static const bool s_log = []
+            {
+                const char *v = std::getenv("PS2X_NATIVE_AUDIO_LOG");
+                return v && *v == '1';
+            }();
+            return s_log;
+        }
+        void logCall(const char *what, uint32_t entry, uint32_t value)
+        {
+            static int s_logged = 0;
+            if (logging() && s_logged++ < 200)
+                std::fprintf(stderr, "[audio] %s %04x = %x\n", what, entry, value);
+        }
+    }
+
+    IopLibsd::IopLibsd(IopMemory &memory, ps2x::audio::NativeMixer &mixer, QueueCall queueCall)
+        : m_memory(memory), m_mixer(mixer), m_queueCall(std::move(queueCall))
+    {
+        // Each half of a block transfer played: the channel's transfer interrupt.
+        m_mixer.setInputHalfCallback([this](int group, int) { transferDone(static_cast<uint32_t>(group)); });
+    }
+
+    void IopLibsd::reset()
+    {
+        m_mixer.reset();
+        m_params.clear();
+        m_switches.clear();
+        m_addresses.clear();
+        m_coreAttributes.clear();
+        m_effectEnd[0] = 0x1DFFFFu;
+        m_effectEnd[1] = 0x1FFFFFu;
+        for (int c = 0; c < 2; ++c)
+        {
+            m_transCallback[c] = {};
+            m_transHandler[c] = {};
+            m_blockBuffer[c] = m_blockSize[c] = 0u;
+            m_effect[c] = {};
+        }
+        m_irqCallback = 0u;
+    }
+
+    uint32_t IopLibsd::arg(const IopCpuState &cpu, int n) const
+    {
+        return n < 4 ? cpu.gpr[4 + n] : m_memory.read32(cpu.gpr[29] + 0x10u + static_cast<uint32_t>(n - 4) * 4u);
+    }
+
+    void IopLibsd::setParam(uint32_t entry, uint32_t value)
+    {
+        logCall("param", entry, value);
+        const int core = coreOf(entry), voice = voiceOf(entry);
+        const uint16_t v = static_cast<uint16_t>(value);
+        if ((entry & 0x80u) == 0u)
+        {
+            switch (entry & 0xFF00u)
+            {
+            case kVolL: m_mixer.setVolume(core, voice, 0, v); return;
+            case kVolR: m_mixer.setVolume(core, voice, 1, v); return;
+            case kPitch: m_mixer.setPitch(core, voice, v); return;
+            case kAdsr1: m_mixer.setAdsr(core, voice, 0, v); return;
+            case kAdsr2: m_mixer.setAdsr(core, voice, 1, v); return;
+            default: break;
+            }
+        }
+        switch (entry & 0xFFFEu)
+        {
+        case kMVolL: m_mixer.setMasterVolume(core, 0, v); return;
+        case kMVolR: m_mixer.setMasterVolume(core, 1, v); return;
+        case kEVolL: m_mixer.setEffectVolume(core, 0, v); return;
+        case kEVolR: m_mixer.setEffectVolume(core, 1, v); return;
+        case kMix: m_mixer.setMix(core, v); return;
+        // The sound data input's volume is BVOL (SPU2 0x76C); AVOL (0x768) is the external input's, core 0's output
+        // into core 1, kept as a plain parameter.
+        case kBVolL: m_mixer.setInputVolume(core, 0, v); return;
+        case kBVolR: m_mixer.setInputVolume(core, 1, v); return;
+        default: m_params[entry] = value; return;
+        }
+    }
+
+    uint32_t IopLibsd::getParam(uint32_t entry) const
+    {
+        const int core = coreOf(entry), voice = voiceOf(entry);
+        if ((entry & 0x80u) == 0u)
+        {
+            switch (entry & 0xFF00u)
+            {
+            case kVolL: return m_mixer.volume(core, voice, 0);
+            case kVolR: return m_mixer.volume(core, voice, 1);
+            case kPitch: return m_mixer.pitch(core, voice);
+            case kAdsr1: return m_mixer.adsr(core, voice, 0);
+            case kAdsr2: return m_mixer.adsr(core, voice, 1);
+            case kEnvX: return m_mixer.envelope(core, voice);
+            case kVolXL: return m_mixer.volume(core, voice, 0) & 0x7FFFu;
+            case kVolXR: return m_mixer.volume(core, voice, 1) & 0x7FFFu;
+            default: break;
+            }
+        }
+        switch (entry & 0xFFFEu)
+        {
+        case kMVolL: return m_mixer.masterVolume(core, 0);
+        case kMVolR: return m_mixer.masterVolume(core, 1);
+        case kEVolL: return m_mixer.effectVolume(core, 0);
+        case kEVolR: return m_mixer.effectVolume(core, 1);
+        case kMix: return m_mixer.mix(core);
+        case kBVolL: return m_mixer.inputVolume(core, 0);
+        case kBVolR: return m_mixer.inputVolume(core, 1);
+        default:
+        {
+            const auto it = m_params.find(entry);
+            return it == m_params.end() ? 0u : it->second;
+        }
+        }
+    }
+
+    void IopLibsd::setSwitch(uint32_t entry, uint32_t value)
+    {
+        logCall("switch", entry, value);
+        const int core = coreOf(entry);
+        switch (entry & 0xFF00u)
+        {
+        case kKon: m_mixer.keyOn(core, value & 0xFFFFFFu); return;
+        case kKoff: m_mixer.keyOff(core, value & 0xFFFFFFu); return;
+        case kEndX: m_mixer.clearEnded(core, 0xFFFFFFu); return;
+        case kVMixL: m_mixer.setDryMask(core, 0, value); return;
+        case kVMixR: m_mixer.setDryMask(core, 1, value); return;
+        case kVMixEL: m_mixer.setWetMask(core, 0, value); return;
+        case kVMixER: m_mixer.setWetMask(core, 1, value); return;
+        default: break;
+        }
+        // PMON (0x13) and NON (0x14): pitch modulation and noise, which the mixer does not play yet.
+        static bool s_warned = false;
+        if (((entry & 0xFF00u) == 0x1300u || (entry & 0xFF00u) == 0x1400u) && value != 0u && !s_warned)
+        {
+            s_warned = true;
+            std::fprintf(stderr, "[audio] native libsd: switch %04x = %x (pitch modulation / noise) is not played\n", entry, value);
+        }
+        m_switches[entry & 0xFF01u] = value;
+    }
+
+    uint32_t IopLibsd::getSwitch(uint32_t entry) const
+    {
+        const int core = coreOf(entry);
+        switch (entry & 0xFF00u)
+        {
+        case kEndX: return m_mixer.ended(core);
+        case kVMixL: return m_mixer.dryMask(core, 0);
+        case kVMixR: return m_mixer.dryMask(core, 1);
+        case kVMixEL: return m_mixer.wetMask(core, 0);
+        case kVMixER: return m_mixer.wetMask(core, 1);
+        default:
+        {
+            const auto it = m_switches.find(entry & 0xFF01u);
+            return it == m_switches.end() ? 0u : it->second;
+        }
+        }
+    }
+
+    void IopLibsd::setAddr(uint32_t entry, uint32_t value)
+    {
+        const int core = coreOf(entry), voice = voiceOf(entry);
+        switch (entry & 0xFFC0u)
+        {
+        case kSsa: m_mixer.setStart(core, voice, value); return;
+        case kLsax: m_mixer.setLoop(core, voice, value); return;
+        default: break;
+        }
+        if ((entry & 0xFF00u) == kEea)
+            m_effectEnd[core] = value | 0x1FFFFu;
+        m_addresses[entry & 0xFF01u] = value; // TSA among them: a transfer's address comes with sceSdVoiceTrans
+    }
+
+    uint32_t IopLibsd::getAddr(uint32_t entry) const
+    {
+        const int core = coreOf(entry), voice = voiceOf(entry);
+        switch (entry & 0xFFC0u)
+        {
+        case kSsa: return m_mixer.start(core, voice);
+        case kLsax: return m_mixer.loop(core, voice);
+        case kNax: return m_mixer.position(core, voice);
+        default: break;
+        }
+        if ((entry & 0xFF00u) == kEea)
+            return m_effectEnd[core];
+        const auto it = m_addresses.find(entry & 0xFF01u);
+        return it == m_addresses.end() ? 0u : it->second;
+    }
+
+    void IopLibsd::setCoreAttr(uint32_t entry, uint32_t value)
+    {
+        logCall("core attribute", entry, value);
+        if ((entry & ~1u) == kEffectEnable)
+            m_mixer.setEffectEnable(coreOf(entry), value != 0u);
+        m_coreAttributes[entry] = value;
+    }
+
+    uint32_t IopLibsd::getCoreAttr(uint32_t entry) const
+    {
+        const auto it = m_coreAttributes.find(entry);
+        return it == m_coreAttributes.end() ? 0u : it->second;
+    }
+
+    // sceSdProcBatch entries: 8 bytes, {u16 function, u16 entry, u32 value}.
+    uint32_t IopLibsd::batchOne(uint32_t function, uint32_t entry, uint32_t value)
+    {
+        switch (function)
+        {
+        case 0x01: setParam(entry, value); return 0u;
+        case 0x02: setSwitch(entry, value); return 0u;
+        case 0x03: setAddr(entry, value); return 0u;
+        case 0x04: setCoreAttr(entry, value); return 0u;
+        case 0x05: m_memory.write32(entry, value); return 0u; // write to IOP memory
+        case 0x10: return getParam(entry);
+        case 0x12: return getSwitch(entry);
+        case 0x13: return getAddr(entry);
+        case 0x14: return getCoreAttr(entry);
+        default: return 0u;
+        }
+    }
+
+    // A transfer's end, as libsd's DMA interrupt reports it: the channel's handler (sceSdSetTransIntrHandler:
+    // handler(channel, its argument)), else its callback (sceSdSetTransCallback: callback(0)).
+    void IopLibsd::transferDone(uint32_t channel)
+    {
+        const Callback &handler = m_transHandler[channel], &callback = m_transCallback[channel];
+        if (handler.function != 0u)
+            m_queueCall(handler.function, channel, handler.argument, handler.gp);
+        else if (callback.function != 0u)
+            m_queueCall(callback.function, 0u, 0u, callback.gp);
+    }
+
+    // sceSdVoiceTrans(channel, mode, iop address, sound memory address, size): mode 0 writes, 1 reads, 2 stops (bits
+    // 3+ choose DMA or I/O: the same here). Done when it returns.
+    uint32_t IopLibsd::voiceTrans(const IopCpuState &cpu)
+    {
+        const uint32_t mode = arg(cpu, 1) & 3u, iop = arg(cpu, 2), sound = arg(cpu, 3), size = arg(cpu, 4);
+        std::vector<uint8_t> data(size);
+        if (mode == 0u || mode == 3u)
+        {
+            if (!m_memory.readRam(iop, data.data(), size))
+                return 0xFFFFFFFFu;
+            m_mixer.write(sound, data.data(), size);
+        }
+        else if (mode == 1u)
+        {
+            m_mixer.read(sound, data.data(), size);
+            if (!m_memory.writeRam(iop, data.data(), size))
+                return 0xFFFFFFFFu;
+        }
+        if (mode == 2u)
+            return 0u;
+        transferDone(arg(cpu, 0) & 1u);
+        return size;
+    }
+
+    // sceSdBlockTrans(channel, mode, iop address, size[, start]): the sound data input of core channel, played from
+    // the driver's buffer as it lies in IOP memory (the driver refills the half that has played). Mode 0 writes from
+    // the start, 3 from start, | 0x10 loops; 2 stops and returns where it was. Writes only (mode 1, reading the
+    // output back, is not done). The end of each half is the channel's transfer interrupt.
+    uint32_t IopLibsd::blockTrans(const IopCpuState &cpu)
+    {
+        const uint32_t channel = arg(cpu, 0) & 1u, mode = arg(cpu, 1), iop = arg(cpu, 2), size = arg(cpu, 3);
+        static int s_logged = 0;
+        if (logging() && s_logged++ < 20)
+            std::fprintf(stderr, "[audio] sceSdBlockTrans(%x, %x, %08x, %x, %x)\n", arg(cpu, 0), mode, iop, size, arg(cpu, 4));
+        switch (mode & 3u)
+        {
+        case 2u:
+        {
+            const uint32_t position = m_blockBuffer[channel] + m_mixer.inputOffset(static_cast<int>(channel));
+            m_mixer.stopInput(static_cast<int>(channel));
+            return position;
+        }
+        case 1u:
+            return 0u;
+        default:
+        {
+            const uint32_t physical = iop & 0x1FFFFFu;
+            const auto ram = m_memory.ram();
+            if (physical + size > ram.size() || size < 1024u)
+                return 0xFFFFFFFFu;
+            const uint32_t start = (mode & 3u) == 3u && arg(cpu, 4) >= iop ? arg(cpu, 4) - iop : 0u;
+            m_blockBuffer[channel] = iop;
+            m_blockSize[channel] = size;
+            m_mixer.startInput(static_cast<int>(channel), ram.data() + physical, size, start, (mode & 0x10u) != 0u);
+            return 0u;
+        }
+        }
+    }
+
+    // sceSdBlockTransStatus(channel, flag): where the input plays now, | 1 << 24 while in the second half.
+    uint32_t IopLibsd::blockTransStatus(uint32_t channel) const
+    {
+        if (!m_mixer.inputPlaying(static_cast<int>(channel)))
+            return 0u;
+        const uint32_t offset = m_mixer.inputOffset(static_cast<int>(channel));
+        const uint32_t second = offset >= m_blockSize[channel] / 2u ? 1u : 0u;
+        return (second << 24u) | (m_blockBuffer[channel] + offset);
+    }
+
+    // sceSdSetEffectAttr(core, attr): attr {int core; int mode (bit 8: clear the area first); short depth_L, depth_R;
+    // int delay; int feedback}. The depths are the effect volumes; the area is the mode's size below the effect end.
+    uint32_t IopLibsd::setEffectAttr(uint32_t core, uint32_t attr)
+    {
+        const uint32_t mode = m_memory.read32(attr + 4u);
+        if ((mode & 0xFFu) >= 10u)
+            return 0xFFFFFFFFu;
+        Effect &effect = m_effect[core];
+        effect.mode = mode & 0xFFu;
+        effect.delay = m_memory.read32(attr + 0xCu);
+        effect.feedback = m_memory.read32(attr + 0x10u);
+        const uint16_t depthL = m_memory.read16(attr + 8u), depthR = m_memory.read16(attr + 0xAu);
+        if (logging())
+            std::fprintf(stderr, "[audio] effect core %u mode %x depth %x/%x delay %u feedback %u end %x\n", core, mode, depthL,
+                         depthR, effect.delay, effect.feedback, m_effectEnd[core]);
+        if ((mode & 0x100u) != 0u)
+            m_mixer.clearEffectArea(static_cast<int>(effect.mode), m_effectEnd[core]);
+        m_mixer.setEffect(static_cast<int>(core), static_cast<int>(effect.mode), effect.delay, effect.feedback, m_effectEnd[core]);
+        m_mixer.setEffectVolume(static_cast<int>(core), 0, depthL);
+        m_mixer.setEffectVolume(static_cast<int>(core), 1, depthR);
+        return 0u;
+    }
+
+    void IopLibsd::getEffectAttr(uint32_t core, uint32_t attr)
+    {
+        const Effect &effect = m_effect[core];
+        m_memory.write32(attr + 4u, effect.mode);
+        m_memory.write16(attr + 8u, m_mixer.effectVolume(static_cast<int>(core), 0));
+        m_memory.write16(attr + 0xAu, m_mixer.effectVolume(static_cast<int>(core), 1));
+        m_memory.write32(attr + 0xCu, effect.delay);
+        m_memory.write32(attr + 0x10u, effect.feedback);
+    }
+
+    bool IopLibsd::dispatchImport(uint16_t ordinal, IopCpuState &cpu)
+    {
+        uint32_t &v0 = cpu.gpr[2];
+        const uint32_t a0 = arg(cpu, 0), a1 = arg(cpu, 1), a2 = arg(cpu, 2), a3 = arg(cpu, 3);
+        switch (ordinal)
+        {
+        case 2: v0 = 0u; return true; // sceSdQuit
+        case 4: reset(); v0 = 0u; return true; // sceSdInit
+        case 5: setParam(a0 & 0xFFFFu, a1); v0 = 0u; return true;
+        case 6: v0 = getParam(a0 & 0xFFFFu); return true;
+        case 7: setSwitch(a0 & 0xFFFFu, a1); v0 = 0u; return true;
+        case 8: v0 = getSwitch(a0 & 0xFFFFu); return true;
+        case 9: setAddr(a0 & 0xFFFFu, a1); v0 = 0u; return true;
+        case 10: v0 = getAddr(a0 & 0xFFFFu); return true;
+        case 11: setCoreAttr(a0 & 0xFFFFu, a1); v0 = 0u; return true;
+        case 12: v0 = getCoreAttr(a0 & 0xFFFFu); return true;
+        case 15: // sceSdProcBatch(batch, returns, count)
+            for (uint32_t i = 0; i < a2; ++i)
+            {
+                const uint32_t at = a0 + i * 8u;
+                const uint32_t result = batchOne(m_memory.read16(at), m_memory.read16(at + 2u), m_memory.read32(at + 4u));
+                if (a1 != 0u)
+                    m_memory.write32(a1 + i * 4u, result);
+            }
+            v0 = a2;
+            return true;
+        case 16: // sceSdProcBatchEx(batch, returns, count, voices): each entry for every voice of the mask
+        {
+            uint32_t written = 0u;
+            for (uint32_t i = 0; i < a2; ++i)
+            {
+                const uint32_t at = a0 + i * 8u;
+                const uint32_t function = m_memory.read16(at), entry = m_memory.read16(at + 2u), value = m_memory.read32(at + 4u);
+                for (uint32_t voice = 0; voice < 24u; ++voice)
+                {
+                    if ((a3 & (1u << voice)) == 0u)
+                        continue;
+                    const uint32_t result = batchOne(function, (entry & ~0x3Eu) | (voice << 1u), value);
+                    if (a1 != 0u)
+                        m_memory.write32(a1 + written * 4u, result);
+                    ++written;
+                }
+            }
+            v0 = written;
+            return true;
+        }
+        case 17: v0 = voiceTrans(cpu); return true;
+        case 18: v0 = blockTrans(cpu); return true;
+        case 19: v0 = 1u; return true; // sceSdVoiceTransStatus: done (transfers finish in the call)
+        case 20: v0 = blockTransStatus(a0 & 1u); return true;
+        case 21: // sceSdSetTransCallback(channel, function)
+        {
+            Callback &callback = m_transCallback[a0 & 1u];
+            v0 = callback.function;
+            callback = {a1, 0u, cpu.gpr[28]};
+            return true;
+        }
+        case 22: v0 = m_irqCallback; m_irqCallback = a0; return true; // sceSdSetIRQCallback
+        case 23: v0 = setEffectAttr(a0 & 1u, a1); return true;
+        case 24: getEffectAttr(a0 & 1u, a1); v0 = 0u; return true;
+        case 25: // sceSdClearEffectWorkArea(core, channel, mode)
+            if ((a2 & 0xFFu) < 10u)
+                m_mixer.clearEffectArea(static_cast<int>(a2 & 0xFFu), m_effectEnd[a0 & 1u]);
+            v0 = 0u;
+            return true;
+        case 26: // sceSdSetTransIntrHandler(channel, handler, argument)
+        {
+            Callback &handler = m_transHandler[a0 & 1u];
+            v0 = handler.function;
+            handler = {a1, a2, cpu.gpr[28]};
+            return true;
+        }
+        case 27: v0 = 0u; return true; // sceSdSetSpu2IntrHandler: no SPU2 interrupts here
+        default:
+            if (ordinal < 64u && (m_loggedOrdinals & (1ull << ordinal)) == 0u)
+            {
+                m_loggedOrdinals |= 1ull << ordinal;
+                std::fprintf(stderr, "[audio] native libsd: ordinal %u not taken over: libsd's own code runs\n", ordinal);
+            }
+            return false;
+        }
+    }
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_libsd.h b/ps2xIOP/src/emulator/imports/iop_libsd.h
new file mode 100644
index 0000000..945700a
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_libsd.h
@@ -0,0 +1,74 @@
+#pragma once
+// libsd taken over at its API (PS2X_NATIVE_AUDIO=1): the game's IOP sound drivers keep calling libsd, and each call
+// acts on the native mixer (devices/iop_native_mixer.h) instead of the SPU2. From TheBozos/PS2Recomp native/gs-backend
+// (ps2xIOP/src/native_libsd.cpp, GPL-3.0); pop-sotc: an HLE import library like timrman, per emulator instead of
+// global, transfer interrupts through the emulator's guest callbacks.
+
+#include <cstdint>
+#include <functional>
+#include <unordered_map>
+
+namespace ps2x::audio
+{
+    class NativeMixer;
+}
+
+namespace ps2x::iop::detail
+{
+    struct IopCpuState;
+    class IopMemory;
+
+    class IopLibsd
+    {
+    public:
+        // Queues a guest call function(a0, a1) with gp, as an interrupt handler would make it, shortly after now.
+        using QueueCall = std::function<void(uint32_t function, uint32_t a0, uint32_t a1, uint32_t gp)>;
+
+        IopLibsd(IopMemory &memory, ps2x::audio::NativeMixer &mixer, QueueCall queueCall);
+
+        void reset();
+        // libsd's export ordinals 2-27 (sceSdQuit .. sceSdSetSpu2IntrHandler); false for any other (logged once): the
+        // caller then runs the loaded libsd module's own code (sceSdNote2Pitch / Pitch2Note are plain math).
+        [[nodiscard]] bool dispatchImport(uint16_t ordinal, IopCpuState &cpu);
+
+    private:
+        struct Callback
+        {
+            uint32_t function = 0, argument = 0, gp = 0;
+        };
+        struct Effect
+        {
+            uint32_t mode = 0, delay = 0, feedback = 0;
+        };
+
+        uint32_t arg(const IopCpuState &cpu, int n) const;
+        void setParam(uint32_t entry, uint32_t value);
+        uint32_t getParam(uint32_t entry) const;
+        void setSwitch(uint32_t entry, uint32_t value);
+        uint32_t getSwitch(uint32_t entry) const;
+        void setAddr(uint32_t entry, uint32_t value);
+        uint32_t getAddr(uint32_t entry) const;
+        void setCoreAttr(uint32_t entry, uint32_t value);
+        uint32_t getCoreAttr(uint32_t entry) const;
+        uint32_t batchOne(uint32_t function, uint32_t entry, uint32_t value);
+        void transferDone(uint32_t channel);
+        uint32_t voiceTrans(const IopCpuState &cpu);
+        uint32_t blockTrans(const IopCpuState &cpu);
+        uint32_t blockTransStatus(uint32_t channel) const;
+        uint32_t setEffectAttr(uint32_t core, uint32_t attr);
+        void getEffectAttr(uint32_t core, uint32_t attr);
+
+        IopMemory &m_memory;
+        ps2x::audio::NativeMixer &m_mixer;
+        QueueCall m_queueCall;
+
+        // The rest of libsd's settings, kept as set (read back as set).
+        std::unordered_map<uint32_t, uint32_t> m_params, m_switches, m_addresses, m_coreAttributes;
+        uint32_t m_effectEnd[2] = {0x1DFFFFu, 0x1FFFFFu}; // sceSdInit's effect end addresses
+        Callback m_transCallback[2], m_transHandler[2];   // per DMA channel
+        uint32_t m_blockBuffer[2] = {}, m_blockSize[2] = {}; // the block transfer playing as each core's input
+        Effect m_effect[2];
+        uint32_t m_irqCallback = 0;
+        uint64_t m_loggedOrdinals = 0;
+    };
+}
