+    // ---------------------------------------------------------------------------------------------
+    // Build-time scheduled programs (VU1R_SCHED=1)
+    //
+    // Every MSCAL starts with an empty pipeline (execute() calls resetScheduler), and an MSCNT follows
+    // a program end, which drains it. From such an entry the runtime's scheduler is fully
+    // determined by the code, so it is run here, at build time, over (pc, pipeline state) nodes (the
+    // approach of catsandsoup's Road Trip Adventure VU1 recompiler, GPL-3.0). Stalls, flag commits and
+    // cycle counts become constants; MAC/status flags that nothing reads are not computed (status
+    // sticky bits are still accumulated cheaply, so the state at the end stays exact). Pairs the
+    // scheduler does not handle, unknown JR targets and unknown entries hand over to the per-pair
+    // compiled code above with the exact pipeline state ("deopt"), so nothing gets less exact.
+    // ---------------------------------------------------------------------------------------------
+    bool g_schedEnabled = false;
+
+    namespace sched
+    {
+        constexpr uint32_t kSlots = 8u;
+        // VU1Interpreter::kFmacLatency and kAccForwardLatency (private there)
+        constexpr uint32_t kFmacLatency = 4u;
+        constexpr uint32_t kAccLatency = 1u;
+        constexpr uint32_t kMaxNodes = 40000u;
+        enum : uint8_t { kNone = 0, kFmac = 1, kClip = 2 };
+        enum : uint8_t { kBrNone = 0, kBrStatic = 1, kBrCond = 2, kBrDyn = 3 };
+
+        struct St
+        {
+            uint8_t vf[32][4];
+            uint8_t vi[16];
+            uint8_t acc[4];
+            uint8_t slotRem[kSlots];
+            uint8_t slotKind[kSlots];
+            uint8_t fdiv;
+            uint8_t backupReg;
+            uint8_t brKind;
+            uint8_t brDelay;
+            uint16_t brTarget;
+            uint8_t ebit;
+            uint8_t pad;
+        };
+
+        St emptySt()
+        {
+            St s;
+            std::memset(&s, 0, sizeof(s));
+            return s;
+        }
+
+        std::string key(const St &s, uint32_t pc, bool body)
+        {
+            std::string k(reinterpret_cast<const char *>(&s), sizeof(St));
+            k.append(reinterpret_cast<const char *>(&pc), sizeof(pc));
+            k.push_back(body ? 1 : 0);
+            return k;
+        }
+
+        uint32_t maxRem(const St &s)
+        {
+            uint32_t m = 0u;
+            for (const auto &reg : s.vf)
+                for (const uint8_t r : reg)
+                    m = std::max<uint32_t>(m, r);
+            for (const uint8_t r : s.vi)
+                m = std::max<uint32_t>(m, r);
+            for (const uint8_t r : s.acc)
+                m = std::max<uint32_t>(m, r);
+            for (const uint8_t r : s.slotRem)
+                m = std::max<uint32_t>(m, r);
+            return std::max<uint32_t>(m, s.fdiv);
+        }
+
+        struct Op
+        {
+            enum Kind : uint8_t { CommitFmac, CommitClip, CommitFdiv, DefFmac, UseMac, Exit } kind;
+            uint8_t slot = 0;
+        };
+
+        // advanceOneCycle in the interpreter's commit order (flag slots, then FDIV)
+        uint32_t advance(St &s, uint32_t cycles, std::vector<Op> &ops)
+        {
+            for (uint32_t n = 0; n < cycles; ++n)
+            {
+                for (auto &reg : s.vf)
+                    for (uint8_t &r : reg)
+                        r = r > 0u ? static_cast<uint8_t>(r - 1u) : 0u;
+                for (uint8_t &r : s.vi)
+                    r = r > 0u ? static_cast<uint8_t>(r - 1u) : 0u;
+                for (uint8_t &r : s.acc)
+                    r = r > 0u ? static_cast<uint8_t>(r - 1u) : 0u;
+                for (uint32_t slot = 0; slot < kSlots; ++slot)
+                {
+                    if (s.slotKind[slot] == kNone)
+                        continue;
+                    if (--s.slotRem[slot] == 0u)
+                    {
+                        ops.push_back({s.slotKind[slot] == kFmac ? Op::CommitFmac : Op::CommitClip, static_cast<uint8_t>(slot)});
+                        s.slotKind[slot] = kNone;
+                    }
+                }
+                if (s.fdiv > 0u && --s.fdiv == 0u)
+                    ops.push_back({Op::CommitFdiv, 0});
+            }
+            return cycles;
+        }
+
+        // the commits a program end performs (runFast's commitFlags(kAll)): all pending, in ready order
+        void flush(St &s, std::vector<Op> &ops)
+        {
+            St copy = s;
+            advance(copy, maxRem(s), ops);
+            s = copy;
+        }
+
+        struct Node
+        {
+            uint32_t pc = 0;
+            St st{};
+            bool body = false;     // after an XGKICK's dynamic stall
+            bool deopt = false;    // hand over to the per-pair code at node entry
+            std::string why;
+            uint32_t stall = 0;
+            std::vector<Op> stallOps;
+            std::vector<Op> bodyOps;   // DefFmac / UseMac
+            std::vector<Op> postOps;
+            int fmacSlot = -1;
+            int clipSlot = -1;
+            // XGKICK dynamic stall: cases s0..kmax, each with its commits and target node
+            bool dyn = false;
+            uint32_t s0 = 0;
+            uint32_t kmax = 0;
+            std::vector<std::pair<std::vector<Op>, uint32_t>> cases;
+            enum Term : uint8_t { Goto, Cond, Dyn, End } term = Goto;
+            uint32_t t0 = 0;
+            uint32_t t1 = 0;
+            std::vector<std::pair<uint32_t, uint32_t>> dynTargets;
+            St after{};            // state after the pair (Dyn default and End)
+            std::vector<Op> flushOps;
+            uint32_t endPc = 0;
+            bool backTarget = false;
+            // liveness results
+            std::vector<bool> needStall, needBody, needPost, needFlush;
+            std::vector<std::vector<bool>> needCases;
+        };
+
+        bool supportedLower(const Pair &p, std::string &why)
+        {
+            if (p.d.iBit)
+                return true;
+            const uint32_t lower = p.d.lower;
+            const uint32_t opHi = (lower >> 25) & 0x7Fu;
+            if (opHi == 0x11u || opHi == 0x15u)
+            {
+                why = "FCSET/FSSET";
+                return false;
+            }
+            if (opHi >= 0x14u && opHi <= 0x17u)
+            {
+                why = "status flag reader";
+                return false;
+            }
+            if (A::pipeline(p.d.lowerUsage) == A::kPipeEfu || p.d.lowerUsage.waitP)
+            {
+                why = "EFU";
+                return false;
+            }
+            const RegViewProbe probe;
+            if (lowerEmit(p.pc, lower, p.d.upper).generic)
+            {
+                why = "generic lower";
+                return false;
+            }
+            return true;
+        }
+
+        struct Graph
+        {
+            const std::vector<Pair> *pairs = nullptr;
+            uint32_t used = 0;
+            std::vector<Node> nodes;
+            std::map<std::string, uint32_t> index;
+            std::vector<uint32_t> work;
+            std::vector<uint32_t> linkLabels;
+            std::map<uint32_t, uint32_t> entries;   // pc -> node
+            bool overflow = false;
+
+            uint32_t get(uint32_t pc, const St &s, bool body = false)
+            {
+                const std::string k = key(s, pc, body);
+                const auto it = index.find(k);
+                if (it != index.end())
+                    return it->second;
+                const uint32_t id = static_cast<uint32_t>(nodes.size());
+                Node n;
+                n.pc = pc;
+                n.st = s;
+                n.body = body;
+                if (nodes.size() >= kMaxNodes)
+                {
+                    overflow = true;
+                    n.deopt = true;
+                    n.why = "node limit";
+                }
+                nodes.push_back(std::move(n));
+                index.emplace(k, id);
+                if (!nodes[id].deopt)
+                    work.push_back(id);
+                return id;
+            }
+
+            static uint32_t staticStall(const Pair &p, const St &s)
+            {
+                uint32_t ready = 0u;
+                for (const auto *usage : {&p.d.upperUsage, &p.d.lowerUsage})
+                {
+                    for (uint32_t i = 0; i < usage->vfReadCount; ++i)
+                    {
+                        const auto access = usage->vfRead[i];
+                        for (uint32_t c = 0; c < 4u; ++c)
+                            if (access.lanes & laneBit(c))
+                                ready = std::max<uint32_t>(ready, s.vf[access.reg][c]);
+                    }
+                    for (uint32_t reg = 1; reg < 16u; ++reg)
+                        if (usage->viRead & (1u << reg))
+                            ready = std::max<uint32_t>(ready, s.vi[reg]);
+                    for (uint32_t c = 0; c < 4u; ++c)
+                        if (usage->accRead & laneBit(c))
+                            ready = std::max<uint32_t>(ready, s.acc[c]);
+                }
+                const unsigned pipe = A::pipeline(p.d.lowerUsage);
+                if (!p.d.iBit && (pipe == A::kPipeFdiv || p.d.lowerUsage.waitQ))
+                    ready = std::max<uint32_t>(ready, s.fdiv);
+                return ready;
+            }
+
+            static int allocSlot(St &s, uint8_t kind)
+            {
+                for (uint32_t slot = 0; slot < kSlots; ++slot)
+                    if (s.slotKind[slot] == kNone)
+                    {
+                        s.slotKind[slot] = kind;
+                        s.slotRem[slot] = static_cast<uint8_t>(kFmacLatency);
+                        return static_cast<int>(slot);
+                    }
+                return -1;
+            }
+
+            void step(uint32_t id)
+            {
+                Node n = nodes[id];
+                const Pair &p = (*pairs)[n.pc / 8u];
+                const auto fail = [&](const std::string &why)
+                {
+                    nodes[id].deopt = true;
+                    nodes[id].why = why;
+                };
+                if (n.pc / 8u >= used || p.fallback || p.reserved)
+                    return fail("fallback pair");
+                if (!supportedLower(p, n.why))
+                    return fail(n.why);
+                {
+                    const RegViewProbe probe;
+                    if (upperEmit(p.d.upper).generic)
+                        return fail("generic upper");
+                }
+                if (p.branch && n.st.brKind != kBrNone)
+                    return fail("branch in a branch delay slot");
+                if (p.branch && n.st.ebit)
+                    return fail("branch in an E-bit delay slot");
+                St s = n.st;
+                if (!n.body)
+                {
+                    const uint32_t s0 = staticStall(p, s);
+                    if (!p.d.iBit && A::pipeline(p.d.lowerUsage) == A::kPipeXgkick)
+                    {
+                        // a previous XGKICK may still run: stall until it ends (data dependent)
+                        n.dyn = true;
+                        n.s0 = s0;
+                        n.kmax = std::max(s0, maxRem(s));
+                        for (uint32_t c = s0; c <= n.kmax; ++c)
+                        {
+                            St m = s;
+                            std::vector<Op> ops;
+                            advance(m, c, ops);
+                            const uint32_t target = get(n.pc, m, true);
+                            n.cases.emplace_back(std::move(ops), target);
+                        }
+                        nodes[id] = std::move(n);
+                        return;
+                    }
+                    n.stall = advance(s, s0, n.stallOps);
+                }
+                // upper flag entry
+                const UpperEmit up = [&]
+                {
+                    const RegViewProbe probe;
+                    return upperEmit(p.d.upper);
+                }();
+                const uint32_t uop = p.d.upper & 0x3Fu;
+                const uint32_t usp = (p.d.upper & 3u) | ((p.d.upper >> 4) & 0x7Cu);
+                const bool isClip = uop >= 0x3Cu && usp == 0x1Fu;
+                if (up.isFmac && up.dest != 0u)
+                {
+                    n.fmacSlot = allocSlot(s, kFmac);
+                    if (n.fmacSlot < 0)
+                        return fail("flag pipeline full");
+                    n.bodyOps.push_back({Op::DefFmac, static_cast<uint8_t>(n.fmacSlot)});
+                }
+                else if (isClip)
+                {
+                    n.clipSlot = allocSlot(s, kClip);
+                    if (n.clipSlot < 0)
+                        return fail("flag pipeline full");
+                }
+                if (!p.d.iBit)
+                {
+                    const uint32_t opHi = (p.d.lower >> 25) & 0x7Fu;
+                    if (opHi == 0x18u || opHi == 0x1Au || opHi == 0x1Bu)
+                        n.bodyOps.push_back({Op::UseMac, 0});
+                    const uint32_t special = (p.d.lower & 3u) | ((p.d.lower >> 4) & 0x7Cu);
+                    if (opHi == 0x40u && (p.d.lower & 0x3Fu) >= 0x3Cu && special >= 0x38u && special <= 0x3Au)
+                        s.fdiv = static_cast<uint8_t>(p.d.lowerUsage.latency);
+                }
+                // markPairWrites
+                const auto lw = p.d.lowerUsage.vfWrite;
+                if (lw.reg != 0u && p.d.suppressedLowerVf != lw.reg)
+                    for (uint32_t c = 0; c < 4u; ++c)
+                        if (lw.lanes & laneBit(c))
+                            s.vf[lw.reg][c] = static_cast<uint8_t>(p.d.lowerUsage.vfLatency != 0u ? p.d.lowerUsage.vfLatency : p.d.lowerUsage.latency);
+                const auto uw = p.d.upperUsage.vfWrite;
+                if (uw.reg != 0u)
+                    for (uint32_t c = 0; c < 4u; ++c)
+                        if (uw.lanes & laneBit(c))
+                            s.vf[uw.reg][c] = static_cast<uint8_t>(p.d.upperUsage.vfLatency != 0u ? p.d.upperUsage.vfLatency : p.d.upperUsage.latency);
+                const uint32_t viWrites = p.d.lowerUsage.viWrite & 0xFFFEu;
+                uint32_t writtenVi = 0u;
+                for (uint32_t reg = 1; reg < 16u; ++reg)
+                    if (viWrites & (1u << reg))
+                    {
+                        s.vi[reg] = static_cast<uint8_t>(p.d.lowerUsage.viLatency != 0u ? p.d.lowerUsage.viLatency : p.d.lowerUsage.latency);
+                        if (writtenVi == 0u)
+                            writtenVi = reg;
+                    }
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if (p.d.upperUsage.accWrite & laneBit(c))
+                        s.acc[c] = static_cast<uint8_t>(kAccLatency);
+                s.backupReg = static_cast<uint8_t>(writtenVi != 0u && p.d.lowerUsage.delaysNextBranchRead ? writtenVi : 0u);
+                // branch state: the delay slot resolves a branch set by the previous pair
+                uint8_t takeKind = kBrNone;
+                uint16_t takeTarget = 0u;
+                if (s.brKind != kBrNone)
+                {
+                    takeKind = s.brKind;
+                    takeTarget = s.brTarget;
+                    s.brKind = kBrNone;
+                    s.brTarget = 0u;
+                }
+                if (p.branch)
+                {
+                    s.brKind = p.dynamic ? kBrDyn : (p.conditional ? kBrCond : kBrStatic);
+                    s.brTarget = static_cast<uint16_t>(p.dynamic ? 0u : p.target);
+                }
+                bool ended = false;
+                if (s.ebit)
+                {
+                    ended = true;
+                    s.ebit = 0u;
+                }
+                else if (p.d.eBit)
+                    s.ebit = 1u;
+                advance(s, 1u, n.postOps);
+                const uint32_t next = nextPc(n.pc);
+                if (ended)
+                {
+                    if (takeKind != kBrNone)
+                        return fail("branch resolves in an E-bit delay slot");
+                    n.term = Node::End;
+                    n.after = s;
+                    flush(s, n.flushOps);
+                    n.endPc = next;
+                    nodes[id] = std::move(n);
+                    return;
+                }
+                n.after = s;
+                if (takeKind == kBrNone)
+                {
+                    n.term = Node::Goto;
+                    n.t0 = get(next, s);
+                }
+                else if (takeKind == kBrStatic)
+                {
+                    n.term = Node::Goto;
+                    n.t0 = get(takeTarget, s);
+                }
+                else if (takeKind == kBrCond)
+                {
+                    n.term = Node::Cond;
+                    n.t0 = get(takeTarget, s);
+                    n.t1 = get(next, s);
+                }
+                else
+                {
+                    n.term = Node::Dyn;
+                    for (const uint32_t label : linkLabels)
+                        n.dynTargets.emplace_back(label, get(label, s));
+                }
+                nodes[id] = std::move(n);
+            }
+
+            std::vector<uint32_t> targets(const Node &n) const
+            {
+                std::vector<uint32_t> out;
+                if (n.deopt)
+                    return out;
+                if (n.dyn)
+                {
+                    for (const auto &c : n.cases)
+                        out.push_back(c.second);
+                    return out;
+                }
+                if (n.term == Node::Goto)
+                    out.push_back(n.t0);
+                else if (n.term == Node::Cond)
+                {
+                    out.push_back(n.t0);
+                    out.push_back(n.t1);
+                }
+                else if (n.term == Node::Dyn)
+                    for (const auto &t : n.dynTargets)
+                        out.push_back(t.second);
+                return out;
+            }
+
+            void build(const std::vector<uint32_t> &entryPcs)
+            {
+                for (const uint32_t pc : entryPcs)
+                    if (pc / 8u < used)
+                        entries[pc] = get(pc, emptySt());
+                while (!work.empty())
+                {
+                    const uint32_t id = work.back();
+                    work.pop_back();
+                    step(id);
+                }
+                for (const Node &n : nodes)
+                    for (const uint32_t t : targets(n))
+                        if (nodes[t].pc <= n.pc)
+                            nodes[t].backTarget = true;
+            }
+
+            // Backward liveness of the MAC/status flags. F = the committed MAC and status (both fully
+            // replaced by each FMAC commit), P<s> = the flags an FMAC in slot s will commit. Program
+            // ends and hand-overs read F and every pending P<s>.
+            using Live = uint32_t;   // bit 0: F, bit 1 + s: P<s>
+            static constexpr Live kF = 1u;
+            static Live pBit(uint32_t slot) { return 2u << slot; }
+
+            static Live pendingFmac(const St &s)
+            {
+                Live l = 0u;
+                for (uint32_t slot = 0; slot < kSlots; ++slot)
+                    if (s.slotKind[slot] == kFmac)
+                        l |= pBit(slot);
+                return l;
+            }
+
+            static Live back(const std::vector<Op> &ops, Live live, std::vector<bool> *need)
+            {
+                if (need)
+                    need->assign(ops.size(), false);
+                for (size_t i = ops.size(); i-- > 0u;)
+                {
+                    const Op &op = ops[i];
+                    switch (op.kind)
+                    {
+                    case Op::CommitFmac:
+                        if (live & kF)
+                        {
+                            if (need)
+                                (*need)[i] = true;
+                            live = (live & ~kF) | pBit(op.slot);
+                        }
+                        break;
+                    case Op::DefFmac:
+                        if (live & pBit(op.slot))
+                        {
+                            if (need)
+                                (*need)[i] = true;
+                            live &= ~pBit(op.slot);
+                        }
+                        break;
+                    case Op::UseMac:
+                    case Op::Exit:
+                        live |= kF;
+                        if (need)
+                            (*need)[i] = true;
+                        break;
+                    default:
+                        if (need)
+                            (*need)[i] = true;
+                        break;
+                    }
+                }
+                return live;
+            }
+
+            std::vector<Live> liveIn;
+
+            Live nodeIn(uint32_t id, Live out, bool record)
+            {
+                Node &n = nodes[id];
+                if (n.deopt)
+                    return kF | pendingFmac(n.st);
+                if (n.dyn)
+                {
+                    Live acc = 0u;
+                    if (record)
+                        n.needCases.resize(n.cases.size());
+                    for (size_t c = 0; c < n.cases.size(); ++c)
+                        acc |= back(n.cases[c].first, liveIn[n.cases[c].second], record ? &n.needCases[c] : nullptr);
+                    return acc;
+                }
+                Live live = out;
+                if (n.term == Node::End)
+                {
+                    std::vector<Op> ops = n.flushOps;
+                    ops.push_back({Op::Exit, 0});
+                    std::vector<bool> need;
+                    live = back(ops, kF, record ? &need : nullptr);
+                    if (record)
+                        n.needFlush.assign(need.begin(), need.end() - 1);
+                }
+                else if (n.term == Node::Dyn)
+                    live |= kF | pendingFmac(n.after);   // the default target hands over
+                live = back(n.postOps, live, record ? &n.needPost : nullptr);
+                live = back(n.bodyOps, live, record ? &n.needBody : nullptr);
+                live = back(n.stallOps, live, record ? &n.needStall : nullptr);
+                return live;
+            }
+
+            Live nodeOut(uint32_t id)
+            {
+                Live out = 0u;
+                for (const uint32_t t : targets(nodes[id]))
+                    out |= liveIn[t];
+                return out;
+            }
+
+            void liveness()
+            {
+                liveIn.assign(nodes.size(), 0u);
+                std::vector<std::vector<uint32_t>> preds(nodes.size());
+                for (uint32_t id = 0; id < nodes.size(); ++id)
+                    for (const uint32_t t : targets(nodes[id]))
+                        preds[t].push_back(id);
+                std::vector<uint32_t> list(nodes.size());
+                std::vector<bool> queued(nodes.size(), true);
+                for (uint32_t id = 0; id < nodes.size(); ++id)
+                    list[id] = id;
+                while (!list.empty())
+                {
+                    const uint32_t id = list.back();
+                    list.pop_back();
+                    queued[id] = false;
+                    const Live in = nodeIn(id, nodeOut(id), false);
+                    if (in != liveIn[id])
+                    {
+                        liveIn[id] = in;
+                        for (const uint32_t p : preds[id])
+                            if (!queued[p])
+                            {
+                                queued[p] = true;
+                                list.push_back(p);
+                            }
+                    }
+                }
+                for (uint32_t id = 0; id < nodes.size(); ++id)
+                    nodeIn(id, nodeOut(id), true);
+            }
+        };
+
+        std::string commitCode(const Op &op, bool needed)
+        {
+            switch (op.kind)
+            {
+            case Op::CommitFmac:
+                return needed ? "        mac = fm" + num(op.slot) + "; scur = fs" + num(op.slot) + " & 0xFu;\n" : "";
+            case Op::CommitClip:
+                return "        clip = fc" + num(op.slot) + ";\n";
+            case Op::CommitFdiv:
+                return "        vu.m_state.q = qpend; sdi = qdi; sticky |= qdi << 6;\n";
+            default:
+                return "";
+            }
+        }
+
+        std::string commits(const std::vector<Op> &ops, const std::vector<bool> &need)
+        {
+            std::string out;
+            for (size_t i = 0; i < ops.size(); ++i)
+                out += commitCode(ops[i], i < need.size() && need[i]);
+            return out;
+        }
+
+        // pipeline state the per-pair code expects when the scheduled code hands over at this point
+        std::string materialize(const St &s, const std::string &base = "cyc", bool readyOnly = false)
+        {
+            std::string out;
+            const std::string cyc = base;
+            for (uint32_t reg = 1; reg < 32u; ++reg)
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if (s.vf[reg][c])
+                        out += "        vu.m_vfReady[" + num(reg) + "][" + num(c) + "] = " + cyc + " + " + num(s.vf[reg][c]) + "u;\n";
+            for (uint32_t reg = 1; reg < 16u; ++reg)
+                if (s.vi[reg])
+                    out += "        vu.m_viReady[" + num(reg) + "] = " + cyc + " + " + num(s.vi[reg]) + "u;\n";
+            for (uint32_t c = 0; c < 4u; ++c)
+                if (s.acc[c])
+                    out += "        vu.m_accReady[" + num(c) + "] = " + cyc + " + " + num(s.acc[c]) + "u;\n";
+            if (readyOnly)
+                return out;
+            std::vector<std::pair<uint32_t, uint32_t>> order;
+            for (uint32_t slot = 0; slot < kSlots; ++slot)
+                if (s.slotKind[slot] != kNone)
+                    order.emplace_back(s.slotRem[slot], slot);
+            std::sort(order.begin(), order.end());
+            for (const auto &[rem, slot] : order)
+            {
+                const std::string at = cyc + " + " + num(rem) + "u - " + num(kFmacLatency) + "u";
+                if (s.slotKind[slot] == kFmac)
+                    out += "        { Vu1FlagRecord &r = statusPush(vu, ctx, " + at + "); r.mac = fm" + num(slot) + "; r.status = fs" + num(slot) +
+                           "; r.writes = Vu1FlagRecord::kMac | Vu1FlagRecord::kStatus; }\n";
+                else
+                    out += "        { Vu1FlagRecord &r = clipPush(vu, ctx, " + at + "); r.clip = fc" + num(slot) + "; r.writes = Vu1FlagRecord::kClip; }\n";
+            }
+            if (s.fdiv)
+                out += "        vu.m_fdiv.valid = true; vu.m_fdiv.readyCycle = " + cyc + " + " + num(s.fdiv) +
+                       "u; vu.m_fdiv.value = qpend; vu.m_fdiv.statusDi = qdi; vu.noteReadyCycle(vu.m_fdiv.readyCycle);\n";
+            if (s.backupReg)
+                out += "        vu.m_viBranchBackupValue = bk; vu.m_viBranchBackupReg = " + num(s.backupReg) + "u; vu.m_viBranchBackupValid = true;\n";
+            if (s.brKind == kBrStatic || s.brKind == kBrDyn)
+                out += "        vu.m_state.branchPending = true; vu.m_state.branchTarget = " + (s.brKind == kBrDyn ? std::string("jt") : hx(s.brTarget)) +
+                       "; vu.m_state.branchDelay = 0u;\n";
+            else if (s.brKind == kBrCond)
+                out += "        if (tk) { vu.m_state.branchPending = true; vu.m_state.branchTarget = " + hx(s.brTarget) + "; vu.m_state.branchDelay = 0u; }\n";
+            if (s.ebit)
+                out += "        vu.m_state.ebit = true;\n";
+            return out;
+        }
+    }
+
+    namespace sched
+    {
+        // One pair under the scheduled model: no stall or ready bookkeeping (constants), flags in slot
+        // variables. Mirrors Emitter::body for the order of the upper and lower halves.
+        std::string pairBody(const Node &n, const Pair &p)
+        {
+            const auto &d = p.d;
+            std::string out = "        {\n";
+            const uint32_t viWrites = d.lowerUsage.viWrite & 0xFFFEu;
+            const uint32_t writtenVi = viWrites != 0u ? static_cast<uint32_t>(std::countr_zero(viWrites)) : 0u;
+            const bool recordBackup = writtenVi != 0u && d.lowerUsage.delaysNextBranchRead;
+            if (recordBackup)
+                out += "            const int32_t oldVi = " + vi(writtenVi) + ";\n";
+            // branches read the locals (or the value before the previous pair's write, kept in bk)
+            const uint32_t backupReg = n.st.backupReg;
+            const BranchVi branchVi = [backupReg](uint32_t r)
+            {
+                if (r == 0u)
+                    return std::string("0");
+                if (r == backupReg)
+                    return std::string("bk");
+                return vi(r);
+            };
+            const BranchVi *branchViPtr = &branchVi;
+            const UpperEmit up = upperEmit(d.upper);
+            bool fmacNeeded = false;
+            for (size_t i = 0; i < n.bodyOps.size(); ++i)
+                if (n.bodyOps[i].kind == Op::DefFmac && i < n.needBody.size() && n.needBody[i])
+                    fmacNeeded = true;
+            const std::string slot = num(n.fmacSlot);
+            std::string fmacValue;
+            std::string fmacDecl = "__m128 un;";
+            std::string fmacAfter;
+            if (up.isFmac)
+            {
+                if (n.fmacSlot >= 0 && fmacNeeded)
+                {
+                    fmacValue = "fmacF" + up.fmacCall + ", fl)";
+                    fmacDecl = "__m128 un; FmacFlags fl;";
+                    fmacAfter = " fm" + slot + " = fl.mac; fs" + slot + " = fl.status; fAccScalar |= fl.status | fl.extra;";
+                }
+                else
+                    fmacValue = "fmacV" + up.fmacCall + ", fAccZ, fAccS, fAccScalar)";
+            }
+            std::string upperStatement = up.statement;
+            if (n.clipSlot >= 0)
+            {
+                // clipOp without the flag queue: the working clip shifts now, the slot commits later
+                const std::string fs = rawV(fFs(d.upper));
+                const std::string ft = rawV(fFt(d.upper));
+                upperStatement = "{ const uint32_t cb = clipBits(" + fs + ", " + ft + "); wclip = ((wclip << 6) | cb) & 0xFFFFFFu; fc" + num(n.clipSlot) +
+                                 " = wclip; }";
+            }
+            const auto upperStore = [&]()
+            {
+                if (up.nop)
+                    return std::string();
+                if (!upperStatement.empty())
+                    return "            " + upperStatement + "\n";
+                if (up.isFmac)
+                    return "            { " + fmacDecl + " const __m128 uv = " + fmacValue + ";" + fmacAfter + " " + writeV(up.reg, "uv", "uv", hx(up.dest)) + " }\n";
+                return "            { const __m128 uv = " + up.value + "; " +
+                       writeV(up.reg, "uv", up.normalize ? std::string("vnorm(uv)") : std::string("uv"), hx(up.dest)) + " }\n";
+            };
+            const bool upperFirst = !d.iBit && d.upperVfShadowReg == 0u;
+            const std::string earlyUpper = upperFirst ? upperStore() : std::string();
+            const LowerEmit low = d.iBit ? LowerEmit{} : lowerEmit(p.pc, d.lower, d.upper, branchViPtr);
+            const std::string lowerCode = low.code.empty() ? "" : "            " + low.code + "\n";
+            if (d.iBit)
+            {
+                uint32_t bits = d.lower;
+                const uint32_t exponent = (bits >> 23) & 0xFFu;
+                if (exponent == 0u)
+                    bits &= 0x80000000u;
+                else if (exponent == 0xFFu)
+                    bits = (bits & 0x80000000u) | 0x7F7FFFFFu;
+                out += upperStore();
+                out += "            vu.m_state.i = std::bit_cast<float>(" + hx(bits) + ");\n";
+            }
+            else if (d.upperVfShadowReg != 0u)
+            {
+                const uint32_t reg = d.upperVfShadowReg;
+                out += "            const __m128 shadowOld = " + rawV(reg) + ";\n";
+                out += "            const __m128 shadowOldN = " + normV(reg) + ";\n";
+                if (up.isFmac)
+                    out += "            " + fmacDecl + " const __m128 uv = " + fmacValue + ";" + fmacAfter + "\n";
+                else
+                    out += "            const __m128 uv = " + up.value + "; const __m128 un = " +
+                           (up.normalize ? std::string("vnorm(uv)") : std::string("uv")) + ";\n";
+                out += lowerCode;
+                out += "            " + writeFullV(reg, "blendDest(shadowOld, uv, " + hx(up.dest) + ")", "blendDest(shadowOldN, un, " + hx(up.dest) + ")") + "\n";
+            }
+            else
+            {
+                out += earlyUpper;
+                out += lowerCode;
+            }
+            if (recordBackup)
+                out += "            bk = oldVi;\n";
+            out += "        }\n";
+            return out;
+        }
+
+        std::string nodeLabel(uint32_t id)
+        {
+            return "n" + num(id);
+        }
+
+        // the program is split into parts (functions); a jump to a node of another part returns to the driver
+        const std::vector<uint32_t> *gPartOf = nullptr;
+        uint32_t gPart = 0u;
+
+        std::string jump(uint32_t id)
+        {
+            if ((*gPartOf)[id] == gPart)
+                return "goto " + nodeLabel(id) + ";";
+            return "{ nx = " + num(id) + "u; goto x_next; }";
+        }
+
+        // cold: hand-over blocks, placed after all nodes so the hot path stays compact
+        std::string emitNode(const Graph &g, uint32_t id, std::string &cold)
+        {
+            const Node &n = g.nodes[id];
+            std::string out = nodeLabel(id) + ": // " + label(n.pc) + (n.body ? " after XGKICK stall" : "") + "\n";
+            if (n.deopt)
+            {
+                out += "        // hand over: " + n.why + "\n";
+                out += materialize(n.st);
+                out += "        epc = " + hx(n.pc) + "; goto x_deopt;\n";
+                return out;
