From ffd58a31871c2edcfb79ed02d78e365a59ad16cd Mon Sep 17 00:00:00 2001
From: Jon <resands@proton.me>
Date: Mon, 19 Oct 2026 09:19:15 +0100
Subject: [PATCH] vu1_recomp: build-time scheduled VU1 programs (VU1R_SCHED=1)

Every MSCAL starts with an empty pipeline and an MSCNT follows a drained program end, so from such an
entry the runtime's scheduler is fully determined by the code. vu1_recomp now runs it at build time over
(pc, pipeline state) nodes, as catsandsoup's Road Trip Adventure VU1 recompiler does (GPL-3.0): stalls,
flag commits and cycle counts become constants, MAC/status flags nothing reads are not computed, an
XGKICK's data-dependent wait becomes a switch over the possible pipeline states. Unsupported pairs,
unknown JR targets and the budget stop hand over to the per-pair code with the exact pipeline state.
Entry points come from <capture dir>/entries.txt. PS2X_VU1_SCHED=0 turns it off at run time.
The verifier treats ready cycles at or before the unit's cycle as equal (they stall nothing).
---
 ps2xRuntime/CMakeLists.txt              |    8 +
 ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp |   18 +-
 ps2xRuntime/src/lib/vu/ps2_vu1_impl.inl |    1 +
 ps2xTest/tools/vu1_recomp.cpp           | 1387 ++++++++++++++++++++++-
 4 files changed, 1400 insertions(+), 14 deletions(-)

diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 9f2f4d4..cd4c44e 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -605,6 +605,14 @@ if(PS2X_VU1_GENERATED_SOURCES)
     if(MSVC)
         set_source_files_properties(${PS2X_VU1_GENERATED_SOURCES} PROPERTIES
             COMPILE_OPTIONS "/bigobj;/fp:precise;/arch:AVX2;/W0")
+        # Parts of build-time scheduled programs are large functions (up to 200 nodes). Above MSVC's huge-function
+        # threshold it stops optimizing, including stack slot reuse: frames of 0.4-2.6 MB overflowed the VU1
+        # thread's stack (19 Oct 2026). With the switch the frame is ~1.6 KB (compile ~6x longer).
+        file(GLOB PS2X_VU1_SCHED_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/vu1_generated/*_sched*.cpp")
+        if(PS2X_VU1_SCHED_SOURCES)
+            set_source_files_properties(${PS2X_VU1_SCHED_SOURCES} PROPERTIES
+                COMPILE_OPTIONS "/bigobj;/fp:precise;/arch:AVX2;/W0;/d2OptimizeHugeFunctions")
+        endif()
     endif()
     target_compile_definitions(ps2EntryRunner PRIVATE PS2X_HAS_VU1_PROGRAMS=1)
 endif()
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
index d557322..401f2fd 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -1277,8 +1277,22 @@ bool VU1InterpreterAccess::runVerifiedWith(VU1Interpreter &vu, uint8_t *vuCode,
         note("ended");
     if (!realEnded && vu.m_cycle != shadow->m_cycle)
         note("cycle " + std::to_string(vu.m_cycle - startCycle) + "/" + std::to_string(shadow->m_cycle - startCycle));
-    if (!sameBits(vu.m_vfReady, shadow->m_vfReady) || !sameBits(vu.m_viReady, shadow->m_viReady) ||
-        !sameBits(vu.m_accReady, shadow->m_accReady))
+    // a ready cycle at or before the unit's cycle stalls nothing, whatever its value (the build-time
+    // scheduled programs only write the ready cycles that are still in the future)
+    const auto readyKey = [](const VU1Interpreter &unit)
+    {
+        std::vector<uint64_t> key;
+        const auto add = [&](uint64_t ready) { key.push_back(ready > unit.m_cycle ? ready - unit.m_cycle : 0u); };
+        for (const auto &lanes : unit.m_vfReady)
+            for (const uint64_t ready : lanes)
+                add(ready);
+        for (const uint64_t ready : unit.m_viReady)
+            add(ready);
+        for (const uint64_t ready : unit.m_accReady)
+            add(ready);
+        return key;
+    };
+    if (readyKey(vu) != readyKey(*shadow))
         note("ready");
     if (vu.m_efuResourceReady != shadow->m_efuResourceReady)
         note("efuReady");
