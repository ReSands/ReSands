diff --git a/ps2xRuntime/tests/mc_image_test.cpp b/ps2xRuntime/tests/mc_image_test.cpp
new file mode 100644
index 0000000..0758445
--- /dev/null
+++ b/ps2xRuntime/tests/mc_image_test.cpp
@@ -0,0 +1,177 @@
+// Self-test for the .ps2 memory card image (McImage). Build and run:
+//   c++ -std=c++17 -O1 -I ps2xRuntime/src/lib/Kernel/Stubs ps2xRuntime/tests/mc_image_test.cpp \
+//       ps2xRuntime/src/lib/Kernel/Stubs/McImage.cpp -o mc_image_test && ./mc_image_test [out.ps2]
+// With an argument it also leaves a card with a test save there (to open in PCSX2 / mymc).
+#include "McImage.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+using namespace ps2_mc;
+
+static int g_fail = 0;
+#define CHECK(c)                                                         \
+    do                                                                   \
+    {                                                                    \
+        if (!(c))                                                        \
+        {                                                                \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c);     \
+            ++g_fail;                                                    \
+        }                                                                \
+    } while (0)
+
+static uint32_t sbU32(const Card &c, uint32_t o)
+{
+    uint32_t v;
+    std::memcpy(&v, &c.raw()[o], 4);
+    return v;
+}
+
+int main(int argc, char **argv)
+{
+    // ECC: single-byte blocks against PCSX2's column_parity_mask row 0 (MemoryCardFile.cpp, from mymc).
+    static const uint8_t mask0[16] = {0, 7, 22, 17, 37, 34, 51, 52, 52, 51, 34, 37, 17, 22, 7, 0};
+    for (int b = 0; b < 16; ++b)
+    {
+        uint8_t blk[128] = {}, ecc[3];
+        blk[0] = uint8_t(b);
+        computeEcc(blk, ecc);
+        CHECK(ecc[0] == uint8_t(0x77 ^ mask0[b]));
+    }
+    uint8_t zero[128] = {}, ecc[3];
+    computeEcc(zero, ecc);
+    CHECK(ecc[0] == 0x77 && ecc[1] == 0x7F && ecc[2] == 0x7F);
+    uint8_t one[128] = {};
+    one[5] = 1; // odd parity at line 5: lp0 ^= ~5, lp1 ^= 5
+    computeEcc(one, ecc);
+    CHECK(ecc[1] == ((0x7F ^ uint8_t(~5)) & 0x7F) && ecc[2] == (0x7F ^ 5));
+
+    Card card;
+    card.format();
+    CHECK(card.formatted());
+    CHECK(card.raw().size() == 16384u * 528u);
+    CHECK(std::memcmp(card.raw().data(), "Sony PS2 Memory Card Format 1.2.0.0", 35) == 0);
+    CHECK(sbU32(card, 0x30) == 8192 && sbU32(card, 0x34) == 41 && sbU32(card, 0x38) == 8135);
+    CHECK(sbU32(card, 0x40) == 1023 && sbU32(card, 0x44) == 1022 && sbU32(card, 0x50) == 8);
+    CHECK(card.raw()[0x150] == 2 && card.raw()[0x151] == 0x2B);
+    CHECK(card.freeClusters() == 8134);
+
+    Loc root;
+    CHECK(card.lookup("/", root) == kOk);
+    std::vector<Entry> rootList = card.list(root);
+    CHECK(rootList.size() == 2 && rootList[0].mode == 0x8427 && rootList[1].mode == 0xA426);
+
+    // A save like PoP's: a folder with icon.sys, an icon bigger than one cluster, and the save data.
+    CHECK(card.mkdir("/BASLUS-20743") == kOk);
+    CHECK(card.mkdir("/BASLUS-20743") == kOk); // existing folder: same answer as the old folder stub
+    CHECK(card.mkdir("/NOPE/SUB") == kNoEntry);
+    std::vector<uint8_t> icon(0xB3F8), save(0x838);
+    for (size_t i = 0; i < icon.size(); ++i)
+        icon[i] = uint8_t(i * 7 + 3);
+    for (size_t i = 0; i < save.size(); ++i)
+        save[i] = uint8_t(i ^ 0x5A);
+    Loc f;
+    CHECK(card.createFile("/BASLUS-20743/icon.ico", f) == kOk);
+    CHECK(card.write(f, 0, icon.data(), 1000) == 1000); // two writes crossing a cluster boundary
+    CHECK(card.write(f, 1000, icon.data() + 1000, uint32_t(icon.size() - 1000)) == int32_t(icon.size() - 1000));
+    CHECK(card.entry(f).length == icon.size());
+    CHECK(card.createFile("/BASLUS-20743/BASLUS-20743", f) == kOk);
+    CHECK(card.write(f, 0, save.data(), uint32_t(save.size())) == int32_t(save.size()));
+    for (int i = 0; i < 4; ++i) // grow the folder past several clusters
+    {
+        Loc x;
+        CHECK(card.createFile("/BASLUS-20743/extra" + std::to_string(i), x) == kOk);
+    }
+    const uint32_t freeBefore = card.freeClusters();
+
+    const char *path = argc > 1 ? argv[1] : "mc_image_test.ps2";
+    CHECK(card.save(path));
+    CHECK(!card.dirty());
+
+    Card back;
+    CHECK(back.load(path));
+    CHECK(back.formatted());
+    CHECK(back.raw() == card.raw());
+    // ECC of every non-erased page must match its data after a save.
+    int badEcc = 0;
+    for (uint32_t p = 0; p < 16384; ++p)
+    {
+        const uint8_t *pg = &back.raw()[size_t(p) * 528];
+        if (p / 16 == 1022)
+            continue;
+        for (int i = 0; i < 4; ++i)
+        {
+            computeEcc(pg + i * 128, ecc);
+            badEcc += std::memcmp(ecc, pg + 512 + i * 3, 3) != 0;
+        }
+    }
+    CHECK(badEcc == 0);
+
+    Loc r;
+    std::vector<uint8_t> got(icon.size());
+    CHECK(back.lookup("/BASLUS-20743/icon.ico", r) == kOk);
+    CHECK(back.read(r, 0, got.data(), uint32_t(got.size() + 50)) == int32_t(icon.size()));
+    CHECK(got == icon);
+    CHECK(back.read(r, 1020, got.data(), 10) == 10 && std::memcmp(got.data(), icon.data() + 1020, 10) == 0);
+    CHECK(back.lookup("/BASLUS-20743/BASLUS-20743", r) == kOk);
+    got.assign(save.size(), 0);
+    CHECK(back.read(r, 0, got.data(), uint32_t(save.size())) == int32_t(save.size()) && got == save);
+    Loc dir;
+    CHECK(back.lookup("/BASLUS-20743", dir) == kOk);
+    CHECK(back.list(dir).size() == 2 + 2 + 4);
+    CHECK(back.entry(dir).length == 8);
+    CHECK(back.lookup("/basLUS-20743", dir) == kNoEntry); // names are case-sensitive
+
+    // Delete and rename.
+    CHECK(back.remove("/BASLUS-20743") == kNotEmpty);
+    CHECK(back.remove("/BASLUS-20743/icon.ico") == kOk);
+    CHECK(back.lookup("/BASLUS-20743/icon.ico", r) == kNoEntry);
+    CHECK(back.freeClusters() == freeBefore + 45); // 0xB3F8 bytes = 45 clusters
+    Loc reused;
+    CHECK(back.createFile("/BASLUS-20743/new", reused) == kOk);
+    CHECK(reused.index == 2); // first deleted slot
+    CHECK(back.rename("/BASLUS-20743/new", "renamed") == kOk);
+    CHECK(back.lookup("/BASLUS-20743/renamed", r) == kOk);
+    CHECK(back.rename("/BASLUS-20743/renamed", "BASLUS-20743") == kDenied);
+    CHECK(back.truncate(r) == kOk && back.entry(r).length == 0);
+
+    // Card full.
+    Loc big;
+    CHECK(back.createFile("/big", big) == kOk);
+    std::vector<uint8_t> huge(9u << 20, 1);
+    const int32_t wrote = back.write(big, 0, huge.data(), uint32_t(huge.size()));
+    CHECK(wrote > 0 && wrote < int32_t(huge.size()));
+    CHECK(back.freeClusters() == 0);
+    CHECK(back.remove("/big") == kOk);
+
+    // A formatted card we cannot read is refused (never offered for formatting); a blank one is unformatted.
+    {
+        std::vector<uint8_t> img = card.raw();
+        const uint32_t badEnd = 9000; // alloc_end past the card's last cluster
+        std::memcpy(&img[0x38], &badEnd, 4);
+        const char *badPath = "mc_image_test_bad.ps2";
+        std::FILE *f = std::fopen(badPath, "wb");
+        std::fwrite(img.data(), 1, img.size(), f);
+        std::fclose(f);
+        Card bad;
+        CHECK(!bad.load(badPath));
+        std::vector<uint8_t> ff(img.size(), 0xFF);
+        f = std::fopen(badPath, "wb");
+        std::fwrite(ff.data(), 1, ff.size(), f);
+        std::fclose(f);
+        Card fresh;
+        CHECK(fresh.load(badPath) && !fresh.formatted());
+        std::remove(badPath);
+    }
+
+    Card blank;
+    blank.unformat();
+    CHECK(!blank.formatted());
+    CHECK(blank.lookup("/", r) == kNoFormat);
+
+    if (argc <= 1)
+        std::remove(path);
+    std::printf(g_fail ? "%d check(s) failed\n" : "all checks passed\n", g_fail);
+    return g_fail ? 1 : 0;
+}
