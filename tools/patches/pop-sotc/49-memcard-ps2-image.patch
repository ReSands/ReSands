+#include "McImage.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#ifdef _WIN32
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace ps2_mc
+{
+    namespace
+    {
+        constexpr uint32_t kEnd = 0xFFFFFFFFu;  // chain end (allocated) / empty-file cluster
+        constexpr uint32_t kUsed = 0x80000000u; // FAT entry in use
+        constexpr uint32_t kFreeEnd = 0x7FFFFFFFu;
+        constexpr char kMagic[] = "Sony PS2 Memory Card Format "; // 28 bytes incl. the trailing space
+
+        Tod nowTod()
+        {
+            const std::time_t t = std::time(nullptr) + 9 * 3600; // the PS2 clock and card stamps are JST
+            std::tm tm{};
+#ifdef _WIN32
+            gmtime_s(&tm, &t);
+#else
+            gmtime_r(&t, &tm);
+#endif
+            return Tod{0, uint8_t(tm.tm_sec), uint8_t(tm.tm_min), uint8_t(tm.tm_hour), uint8_t(tm.tm_mday),
+                       uint8_t(tm.tm_mon + 1), uint16_t(tm.tm_year + 1900)};
+        }
+
+        Entry makeEntry(uint16_t mode, const std::string &name)
+        {
+            Entry e{};
+            e.mode = mode;
+            e.created = e.modified = nowTod();
+            std::strncpy(e.name, name.c_str(), sizeof(e.name) - 1);
+            return e;
+        }
+
+        bool sameName(const Entry &e, const std::string &name)
+        {
+            return std::strncmp(e.name, name.c_str(), sizeof(e.name)) == 0;
+        }
+
+        // Wide on Windows so a user folder with any characters works (path::string() would not).
+        std::FILE *openFile(const std::filesystem::path &p, bool write)
+        {
+#ifdef _WIN32
+            return _wfopen(p.c_str(), write ? L"wb" : L"rb");
+#else
+            return std::fopen(p.c_str(), write ? "wb" : "rb");
+#endif
+        }
+
+        std::vector<std::string> split(const std::string &path)
+        {
+            std::vector<std::string> parts;
+            std::string cur;
+            for (char c : path)
+            {
+                if (c == '/')
+                {
+                    if (!cur.empty())
+                        parts.push_back(cur);
+                    cur.clear();
+                }
+                else
+                    cur += c;
+            }
+            if (!cur.empty())
+                parts.push_back(cur);
+            return parts;
+        }
+    }
+
+    // Hamming ECC per 128 bytes, as mymc / PCSX2 MemoryCardFile.cpp compute it (tables built, not pasted).
+    void computeEcc(const uint8_t *d, uint8_t out[3])
+    {
+        struct Tables
+        {
+            std::array<uint8_t, 256> parity{}, column{};
+            Tables()
+            {
+                static const uint8_t masks[7] = {0x55, 0x33, 0x0F, 0x00, 0xAA, 0xCC, 0xF0};
+                auto par = [](unsigned v)
+                {
+                    unsigned p = 0;
+                    for (; v; v >>= 1)
+                        p ^= v & 1u;
+                    return uint8_t(p);
+                };
+                for (unsigned b = 0; b < 256; ++b)
+                {
+                    parity[b] = par(b);
+                    for (unsigned i = 0; i < 7; ++i)
+                        column[b] |= uint8_t(par(b & masks[i]) << i);
+                }
+            }
+        };
+        static const Tables t;
+        uint8_t cp = 0x77, lp0 = 0x7F, lp1 = 0x7F;
+        for (unsigned i = 0; i < 128; ++i)
+        {
+            cp ^= t.column[d[i]];
+            if (t.parity[d[i]])
+            {
+                lp0 ^= uint8_t(~i);
+                lp1 ^= uint8_t(i);
+            }
+        }
+        out[0] = cp;
+        out[1] = lp0 & 0x7F;
+        out[2] = lp1;
+    }
+
+    bool Card::load(const std::filesystem::path &file)
+    {
+        std::FILE *f = openFile(file, false);
+        if (!f)
+            return false;
+        std::vector<uint8_t> data;
+        uint8_t buf[65536];
+        size_t n;
+        while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0)
+            data.insert(data.end(), buf, buf + n);
+        std::fclose(f);
+        // shortcut: only images with ECC (PCSX2's .ps2); raw 8 MB dumps without spare bytes are refused.
+        if (data.empty() || data.size() % (kRawPage * 16) != 0)
+            return false;
+        m_raw = std::move(data);
+        m_dirtyPages.clear();
+        m_dirty = false;
+        // A card that says it is formatted but fails our checks is refused, never offered for formatting:
+        // a misreading of ours must not end with the user erasing a card full of saves.
+        return parseSuperblock() || std::memcmp(m_raw.data(), kMagic, 28) != 0;
+    }
+
+    bool Card::save(const std::filesystem::path &file)
+    {
+        for (uint32_t page : m_dirtyPages)
+        {
+            uint8_t *p = &m_raw[size_t(page) * kRawPage];
+            for (uint32_t i = 0; i < 4; ++i)
+                computeEcc(p + i * 128, p + kPage + i * 3);
+            std::memset(p + kPage + 12, 0, 4); // mymc pads the spare with zeros
+        }
+        m_dirtyPages.clear();
+
+        std::error_code ec;
+        if (file.has_parent_path())
+            std::filesystem::create_directories(file.parent_path(), ec);
+        std::filesystem::path tmp = file;
+        tmp += ".tmp";
+        std::FILE *f = openFile(tmp, true);
+        if (!f)
+            return false;
+        bool ok = std::fwrite(m_raw.data(), 1, m_raw.size(), f) == m_raw.size() && std::fflush(f) == 0;
+#ifdef _WIN32
+        ok = ok && _commit(_fileno(f)) == 0;
+#else
+        ok = ok && fsync(fileno(f)) == 0;
+#endif
+        ok = (std::fclose(f) == 0) && ok;
+        if (ok)
+            std::filesystem::rename(tmp, file, ec); // replaces the old card in one step: old or new, never half
+        if (!ok || ec)
+        {
+            std::filesystem::remove(tmp, ec);
+            return false;
+        }
+        m_dirty = false;
+        return true;
+    }
+
+    bool Card::parseSuperblock()
+    {
+        m_formatted = false;
+        if (m_raw.size() < kRawPage || std::memcmp(m_raw.data(), kMagic, 28) != 0)
+            return false;
+        auto u16 = [&](uint32_t o) { return uint32_t(m_raw[o] | (m_raw[o + 1] << 8)); };
+        auto u32 = [&](uint32_t o)
+        {
+            uint32_t v;
+            std::memcpy(&v, &m_raw[o], 4);
+            return v;
+        };
+        if (u16(0x28) != kPage || u16(0x2A) != 2)
+            return false;
+        m_allocOffset = u32(0x34);
+        m_allocEnd = u32(0x38);
+        m_root = u32(0x3C);
+        for (uint32_t i = 0; i < 32; ++i)
+            m_ifc[i] = u32(0x50 + i * 4);
+        const uint64_t clusters = m_raw.size() / kRawPage / 2;
+        m_formatted = m_allocOffset + uint64_t(m_allocEnd) <= clusters && m_root < m_allocEnd;
+        return m_formatted;
+    }
+
+    bool Card::formatted() const { return m_formatted; }
+
+    void Card::format()
+    {
+        const uint32_t pages = kStandardPages, clusters = pages / 2, blocks = pages / 16;
+        m_raw.assign(size_t(pages) * kRawPage, 0); // mymc: erased = zero data with ECC
+        m_dirtyPages.clear();
+        const uint32_t badBlock2 = blocks - 2;
+        for (uint32_t p = 0; p < pages; ++p)
+            if (p / 16 != badBlock2)
+                m_dirtyPages.insert(p);
+
+        uint8_t sb[0x154] = {};
+        std::memcpy(sb, kMagic, 28);
+        std::memcpy(sb + 0x1C, "1.2.0.0", 7);
+        auto put16 = [&](uint32_t o, uint16_t v) { std::memcpy(sb + o, &v, 2); };
+        auto put32 = [&](uint32_t o, uint32_t v) { std::memcpy(sb + o, &v, 4); };
+        const uint32_t fatClusters = (clusters + 255) / 256;       // 32
+        const uint32_t firstIfc = 8, firstFat = firstIfc + 1;       // block 0 holds the superblock
+        const uint32_t allocOffset = firstFat + fatClusters;        // 41
+        const uint32_t allocEnd = (blocks - 2) * 8 - allocOffset;   // 8135
+        put16(0x28, kPage);
+        put16(0x2A, 2);
+        put16(0x2C, 16);
+        put16(0x2E, 0xFF00);
+        put32(0x30, clusters);
+        put32(0x34, allocOffset);
+        put32(0x38, allocEnd);
+        put32(0x3C, 0);
+        put32(0x40, blocks - 1);
+        put32(0x44, blocks - 2);
+        put32(0x50, firstIfc);
+        std::memset(sb + 0xD0, 0xFF, 128);
+        sb[0x150] = 2;
+        sb[0x151] = 0x2B;
+        std::memcpy(m_raw.data(), sb, sizeof(sb));
+        for (uint32_t p = badBlock2 * 16; p < badBlock2 * 16 + 16; ++p)
+            std::memset(&m_raw[size_t(p) * kRawPage], 0xFF, kRawPage);
+
+        if (!parseSuperblock())
+            return;
+        for (uint32_t i = 0; i < 256; ++i)
+            setU32At(firstIfc, i * 4, i < fatClusters ? firstFat + i : kEnd);
+        // mymc: entry 0 = root (chain end), free up to alloc_end, chain end up to its allocatable_clusters
+        // (clusters - 10), the tail stays erased (0). Entries past alloc_end are never used.
+        for (uint32_t i = 0; i < fatClusters * 256; ++i)
+            setFat(i, i == 0 ? kEnd : i < allocEnd ? kFreeEnd : i < clusters - 10 ? kEnd : 0);
+
+        Entry dot = makeEntry(kModeRead | kModeWrite | kModeExec | kModeDir | kMode0400 | kModeExists, ".");
+        dot.length = 2;
+        Entry dotdot = makeEntry(kModeWrite | kModeExec | kModeDir | kMode0400 | kModeHidden | kModeExists, "..");
+        dotdot.created = dotdot.modified = dot.created;
+        putEntry({0, 0}, dot);
+        putEntry({0, 1}, dotdot);
+        m_dirty = true;
+    }
+
+    void Card::unformat()
+    {
+        m_raw.assign(m_raw.empty() ? size_t(kStandardPages) * kRawPage : m_raw.size(), 0xFF);
+        m_dirtyPages.clear();
+        m_formatted = false;
+        m_dirty = true;
+    }
+
+    uint32_t Card::u32At(uint32_t absCluster, uint32_t offset) const
+    {
+        const size_t page = size_t(absCluster) * 2 + offset / kPage;
+        uint32_t v = kEnd;
+        if ((page + 1) * kRawPage <= m_raw.size())
+            std::memcpy(&v, &m_raw[page * kRawPage + offset % kPage], 4);
+        return v;
+    }
+
+    void Card::setU32At(uint32_t absCluster, uint32_t offset, uint32_t value)
+    {
+        writeBytes(absCluster, offset, &value, 4);
+    }
+
+    void Card::writeBytes(uint32_t absCluster, uint32_t offset, const void *src, uint32_t size)
+    {
+        const uint8_t *s = static_cast<const uint8_t *>(src);
+        while (size > 0)
+        {
+            const size_t page = size_t(absCluster) * 2 + offset / kPage;
+            const uint32_t in = offset % kPage, n = std::min(size, kPage - in);
+            if ((page + 1) * kRawPage > m_raw.size())
+                return;
+            std::memcpy(&m_raw[page * kRawPage + in], s, n);
+            m_dirtyPages.insert(uint32_t(page));
+            m_dirty = true;
+            s += n;
+            offset += n;
+            size -= n;
+        }
+    }
+
+    void Card::readCluster(uint32_t absCluster, uint8_t *dst) const
+    {
+        for (uint32_t i = 0; i < 2; ++i)
+        {
+            const size_t page = size_t(absCluster) * 2 + i;
+            if ((page + 1) * kRawPage <= m_raw.size())
+                std::memcpy(dst + i * kPage, &m_raw[page * kRawPage], kPage);
+        }
+    }
+
+    uint32_t Card::fat(uint32_t rel) const
+    {
+        const uint32_t ind = rel / 256;
+        if (ind / 256 >= 32)
+            return kEnd;
+        const uint32_t fatCluster = u32At(m_ifc[ind / 256], (ind % 256) * 4);
+        return u32At(fatCluster, (rel % 256) * 4);
+    }
+
+    void Card::setFat(uint32_t rel, uint32_t value)
+    {
+        const uint32_t ind = rel / 256;
+        if (ind / 256 >= 32)
+            return;
+        setU32At(u32At(m_ifc[ind / 256], (ind % 256) * 4), (rel % 256) * 4, value);
+    }
+
+    uint32_t Card::chainCluster(uint32_t c, uint32_t n) const
+    {
+        for (uint32_t i = 0; i < n; ++i)
+        {
+            if (c >= m_allocEnd)
+                return kEnd;
+            const uint32_t v = fat(c);
+            if (v == kEnd || !(v & kUsed))
+                return kEnd;
+            c = v & ~kUsed;
+        }
+        return c < m_allocEnd ? c : kEnd;
+    }
+
+    uint32_t Card::allocate()
+    {
+        for (uint32_t rel = 0; rel < m_allocEnd; ++rel)
+        {
+            if (fat(rel) & kUsed)
+                continue;
+            setFat(rel, kEnd);
+            static const uint8_t zero[kCluster] = {};
+            writeBytes(rel + m_allocOffset, 0, zero, kCluster);
+            return rel;
+        }
+        return kEnd;
+    }
+
+    void Card::freeChain(uint32_t c)
+    {
+        // As mymc / mcman: clear the in-use bit along the chain, the last link becomes 0x7FFFFFFF.
+        for (uint32_t guard = 0; c < m_allocEnd && guard < m_allocEnd; ++guard)
+        {
+            const uint32_t v = fat(c);
+            if (!(v & kUsed))
+                break;
+            setFat(c, v & ~kUsed);
+            if ((v & ~kUsed) == kFreeEnd)
+                break;
+            c = v & ~kUsed;
+        }
+    }
+
+    uint32_t Card::freeClusters() const
+    {
+        uint32_t n = 0;
+        for (uint32_t rel = 0; m_formatted && rel < m_allocEnd; ++rel)
+            n += (fat(rel) & kUsed) ? 0u : 1u;
+        return n;
+    }
+
+    const uint8_t *Card::entryPtr(const Loc &loc) const
+    {
+        const uint32_t c = chainCluster(loc.dirCluster, loc.index / 2);
+        if (c == kEnd)
+            return nullptr;
+        const size_t page = size_t(c + m_allocOffset) * 2 + loc.index % 2;
+        return (page + 1) * kRawPage <= m_raw.size() ? &m_raw[page * kRawPage] : nullptr;
+    }
+
+    Entry Card::entry(const Loc &loc) const
+    {
+        Entry e{};
+        if (const uint8_t *p = entryPtr(loc))
+            std::memcpy(&e, p, sizeof(e));
+        return e;
+    }
+
+    void Card::putEntry(const Loc &loc, const Entry &e)
+    {
+        const uint32_t c = chainCluster(loc.dirCluster, loc.index / 2);
+        if (c != kEnd)
+            writeBytes(c + m_allocOffset, (loc.index % 2) * kPage, &e, sizeof(e));
+    }
+
+    std::vector<Entry> Card::list(const Loc &dir) const
+    {
+        std::vector<Entry> out;
+        const Entry d = entry(dir);
+        for (uint32_t i = 0; (d.mode & kModeDir) && i < d.length; ++i)
+        {
+            const Entry e = entry({d.cluster, i});
+            if (e.mode & kModeExists)
+                out.push_back(e);
+        }
+        return out;
+    }
+
+    int32_t Card::findChild(const Loc &dir, const std::string &name, Loc &out) const
+    {
+        const Entry d = entry(dir);
+        if (!(d.mode & kModeDir))
+            return kNoEntry;
+        for (uint32_t i = 0; i < d.length; ++i)
+        {
+            const Entry e = entry({d.cluster, i});
+            if ((e.mode & kModeExists) && sameName(e, name))
+            {
+                out = {d.cluster, i};
+                return kOk;
+            }
+        }
+        return kNoEntry;
+    }
+
+    int32_t Card::lookup(const std::string &path, Loc &out) const
+    {
+        if (!m_formatted)
+            return kNoFormat;
+        Loc cur{m_root, 0};
+        for (const std::string &part : split(path))
+        {
+            Loc next;
+            if (findChild(cur, part, next) != kOk)
+                return kNoEntry;
+            cur = next;
+        }
+        out = cur;
+        return kOk;
+    }
+
+    int32_t Card::parentOf(const std::string &path, Loc &dir, std::string &name) const
+    {
+        std::vector<std::string> parts = split(path);
+        if (parts.empty())
+            return kDenied;
+        name = parts.back();
+        if (name.size() >= sizeof(Entry::name))
+            return kDenied;
+        std::string parent;
+        for (size_t i = 0; i + 1 < parts.size(); ++i)
+            parent += "/" + parts[i];
+        const int32_t r = lookup(parent.empty() ? "/" : parent, dir);
+        if (r != kOk)
+            return r;
+        return (entry(dir).mode & kModeDir) ? kOk : kNoEntry;
+    }
+
+    int32_t Card::addEntry(const Loc &dir, const Entry &e, Loc &out)
+    {
+        Entry d = entry(dir);
+        for (uint32_t i = 2; i < d.length; ++i) // reuse a deleted slot first, as mymc does
+        {
+            if (!(entry({d.cluster, i}).mode & kModeExists))
+            {
+                out = {d.cluster, i};
+                putEntry(out, e);
+                return kOk;
+            }
+        }
+        if (d.length % 2 == 0) // two entries per cluster: the directory needs one more
+        {
+            const uint32_t c = allocate();
+            if (c == kEnd)
+                return kFull;
+            setFat(chainCluster(d.cluster, d.length / 2 - 1), kUsed | c);
+        }
+        out = {d.cluster, d.length};
+        putEntry(out, e);
+        d.length += 1;
+        d.modified = nowTod();
+        putEntry(dir, d);
+        return kOk;
+    }
+
+    int32_t Card::mkdir(const std::string &path)
+    {
+        Loc dir, existing;
+        std::string name;
+        int32_t r = parentOf(path, dir, name);
+        if (r != kOk)
+            return r;
+        if (findChild(dir, name, existing) == kOk)
+            return (entry(existing).mode & kModeDir) ? kOk : kDenied; // the old folder stub's answer
+        const uint32_t c = allocate();
+        if (c == kEnd)
+            return kFull;
+        Entry e = makeEntry(kModeRead | kModeWrite | kModeExec | kModeDir | kMode0400 | kModeExists, name);
+        e.length = 2;
+        e.cluster = c;
+        Loc at;
+        if ((r = addEntry(dir, e, at)) != kOk)
+        {
+            freeChain(c);
+            return r;
+        }
+        Entry dot = makeEntry(e.mode, "."), dotdot = makeEntry(e.mode, "..");
+        dot.dirEntry = at.index;
+        putEntry({c, 0}, dot);
+        putEntry({c, 1}, dotdot);
+        return kOk;
+    }
+
+    int32_t Card::createFile(const std::string &path, Loc &out)
+    {
+        Loc dir;
+        std::string name;
+        const int32_t r = parentOf(path, dir, name);
+        if (r != kOk)
+            return r;
+        Entry e = makeEntry(kModeRead | kModeWrite | kModeExec | kModeFile | kMode0080 | kMode0400 | kModeExists, name);
+        e.cluster = kEnd;
+        return addEntry(dir, e, out);
+    }
+
+    int32_t Card::remove(const std::string &path)
+    {
+        Loc loc;
+        int32_t r = lookup(path, loc);
+        if (r != kOk)
+            return r;
+        if (split(path).empty())
+            return kDenied;
+        Entry e = entry(loc);
+        if ((e.mode & kModeDir) && list(loc).size() > 2)
+            return kNotEmpty;
+        e.mode &= ~kModeExists; // the slot stays; the parent's length is unchanged (mymc, mcman)
+        putEntry(loc, e);
+        if (e.cluster != kEnd)
+            freeChain(e.cluster);
+        return kOk;
+    }
+
+    int32_t Card::rename(const std::string &path, const std::string &newName)
+    {
+        Loc loc, dir, clash;
+        std::string oldName;
+        int32_t r = lookup(path, loc);
+        if (r != kOk || (r = parentOf(path, dir, oldName)) != kOk)
+            return r;
+        if (newName.empty() || newName.size() >= sizeof(Entry::name) || newName.find('/') != std::string::npos)
+            return kDenied;
+        if (findChild(dir, newName, clash) == kOk)
+            return kDenied;
+        Entry e = entry(loc);
+        std::memset(e.name, 0, sizeof(e.name));
+        std::memcpy(e.name, newName.data(), newName.size());
+        putEntry(loc, e);
+        return kOk;
+    }
+
+    int32_t Card::truncate(const Loc &file)
+    {
+        Entry e = entry(file);
+        if (e.cluster != kEnd)
+            freeChain(e.cluster);
+        e.cluster = kEnd;
+        e.length = 0;
+        e.modified = nowTod();
+        putEntry(file, e);
+        return kOk;
+    }
+
+    int32_t Card::read(const Loc &file, uint32_t pos, uint8_t *dst, uint32_t size) const
+    {
+        const Entry e = entry(file);
+        if (pos >= e.length)
+            return 0;
+        size = std::min(size, e.length - pos);
+        uint32_t done = 0;
+        uint8_t buf[kCluster];
+        while (done < size)
+        {
+            const uint32_t c = chainCluster(e.cluster, (pos + done) / kCluster);
+            if (c == kEnd)
+                break;
+            readCluster(c + m_allocOffset, buf);
+            const uint32_t off = (pos + done) % kCluster, n = std::min(size - done, kCluster - off);
+            std::memcpy(dst + done, buf + off, n);
+            done += n;
+        }
+        return int32_t(done);
+    }
+
+    int32_t Card::write(const Loc &file, uint32_t pos, const uint8_t *src, uint32_t size)
+    {
+        Entry e = entry(file);
+        if (e.cluster == kEnd && size > 0)
+        {
+            if ((e.cluster = allocate()) == kEnd)
+                return kFull;
+        }
+        uint32_t c = e.cluster, idx = 0, done = 0;
+        while (done < size)
+        {
+            const uint32_t want = (pos + done) / kCluster;
+            for (; idx < want; ++idx)
+            {
+                const uint32_t v = fat(c);
+                if (v == kEnd)
+                {
+                    const uint32_t n = allocate();
+                    if (n == kEnd)
+                        break;
+                    setFat(c, kUsed | n);
+                    c = n;
+                }
+                else
+                    c = v & ~kUsed;
+            }
+            if (idx < want)
+                break; // card full
+            const uint32_t off = (pos + done) % kCluster, n = std::min(size - done, kCluster - off);
+            writeBytes(c + m_allocOffset, off, src + done, n);
+            done += n;
+        }
+        if (done > 0)
+        {
+            e.length = std::max(e.length, pos + done);
+            e.modified = nowTod();
+        }
+        putEntry(file, e);
+        return (done == 0 && size > 0) ? kFull : int32_t(done);
+    }
+}
