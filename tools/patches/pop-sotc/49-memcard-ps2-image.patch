new file mode 100644
index 0000000..c01f363
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/McImage.h
@@ -0,0 +1,112 @@
+#pragma once
+
+// PS2 memory card file system on a PCSX2-compatible raw image (.ps2: 512-byte pages + 16-byte spare with ECC).
+// Format facts from open-source code only: PCSX2 (GPL-3) MemoryCardFolder/MemoryCardFile, mymc (public domain),
+// ps2sdk mcman (AFL). No runtime dependencies so it can be tested on its own (ps2xRuntime/tests/mc_image_test.cpp).
+
+#include <cstdint>
+#include <filesystem>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace ps2_mc
+{
+    // libmc result codes (same values the stubs return to the game).
+    constexpr int32_t kOk = 0;
+    constexpr int32_t kNoFormat = -2;
+    constexpr int32_t kFull = -3;
+    constexpr int32_t kNoEntry = -4;
+    constexpr int32_t kDenied = -5;
+    constexpr int32_t kNotEmpty = -6;
+
+    constexpr uint16_t kModeRead = 0x0001, kModeWrite = 0x0002, kModeExec = 0x0004, kModeFile = 0x0010,
+                       kModeDir = 0x0020, kMode0080 = 0x0080, kMode0400 = 0x0400, kModeHidden = 0x2000,
+                       kModeExists = 0x8000;
+
+#pragma pack(push, 1)
+    struct Tod // stored as on the card (the PS2 keeps JST)
+    {
+        uint8_t unused, sec, min, hour, day, month;
+        uint16_t year;
+    };
+
+    struct Entry
+    {
+        uint16_t mode;
+        uint16_t unused0;
+        uint32_t length; // bytes for a file, entry count (incl. "." and "..") for a directory
+        Tod created;
+        uint32_t cluster; // first cluster, relative to alloc_offset; 0xFFFFFFFF = empty file
+        uint32_t dirEntry;
+        Tod modified;
+        uint32_t attr;
+        uint8_t pad[28];
+        char name[32];
+        uint8_t unused1[416];
+    };
+#pragma pack(pop)
+    static_assert(sizeof(Entry) == 512, "card directory entry is 512 bytes");
+
+    // An entry's place: the first cluster of the directory holding it and its index there. Root "." is {0, 0}.
+    struct Loc
+    {
+        uint32_t dirCluster = 0;
+        uint32_t index = 0;
+    };
+
+    void computeEcc(const uint8_t *data128, uint8_t out[3]);
+
+    class Card
+    {
+    public:
+        static constexpr uint32_t kPage = 512, kSpare = 16, kRawPage = kPage + kSpare, kCluster = 1024;
+        static constexpr uint32_t kStandardPages = 16384; // 8 MB card
+
+        bool load(const std::filesystem::path &file); // false: missing, bad size, or a formatted card we cannot read
+        bool save(const std::filesystem::path &file);  // crash-safe: tmp, flush to disk, rename over
+        void format();                                 // fresh standard 8 MB card (mymc's layout)
+        void unformat();                               // all 0xFF, like a new PCSX2 card
+        bool formatted() const;
+        bool dirty() const { return m_dirty; }
+        uint32_t freeClusters() const;
+        const std::vector<uint8_t> &raw() const { return m_raw; }
+
+        // Paths are absolute card paths ("/", "/BASLUS-20743", "/BASLUS-20743/icon.sys").
+        int32_t lookup(const std::string &path, Loc &out) const;
+        Entry entry(const Loc &loc) const;
+        std::vector<Entry> list(const Loc &dir) const; // existing entries, card order ("." and ".." first)
+        int32_t mkdir(const std::string &path);
+        int32_t createFile(const std::string &path, Loc &out);
+        int32_t remove(const std::string &path);
+        int32_t rename(const std::string &path, const std::string &newName);
+        int32_t truncate(const Loc &file);
+        int32_t read(const Loc &file, uint32_t pos, uint8_t *dst, uint32_t size) const;
+        int32_t write(const Loc &file, uint32_t pos, const uint8_t *src, uint32_t size);
+
+    private:
+        uint32_t u32At(uint32_t absCluster, uint32_t offset) const;
+        void setU32At(uint32_t absCluster, uint32_t offset, uint32_t value);
+        void readCluster(uint32_t absCluster, uint8_t *dst) const;
+        void writeBytes(uint32_t absCluster, uint32_t offset, const void *src, uint32_t size);
+        uint32_t fat(uint32_t rel) const;
+        void setFat(uint32_t rel, uint32_t value);
+        uint32_t chainCluster(uint32_t first, uint32_t n) const; // n-th cluster of a chain, 0xFFFFFFFF if short
+        uint32_t allocate();                                       // 0xFFFFFFFF when full
+        void freeChain(uint32_t first);
+        void putEntry(const Loc &loc, const Entry &e);
+        int32_t addEntry(const Loc &dir, const Entry &e, Loc &out);
+        int32_t findChild(const Loc &dir, const std::string &name, Loc &out) const;
+        int32_t parentOf(const std::string &path, Loc &dir, std::string &name) const;
+
+        std::vector<uint8_t> m_raw;
+        std::set<uint32_t> m_dirtyPages; // ECC recomputed on save for touched pages only
+        bool m_dirty = false;
+        bool parseSuperblock();
+        const uint8_t *entryPtr(const Loc &loc) const;
+
+        bool m_formatted = false;
+        uint32_t m_allocOffset = 0, m_allocEnd = 0, m_root = 0;
+        uint32_t m_ifc[32] = {};
+    };
+}
