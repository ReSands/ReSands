+// COP0 Count runs at the EE clock (294.912 MHz). Games time frames and fades with it, so it
+// must advance: derive it from host time. cop0_count holds the offset set by MTC0 Count.
+inline uint32_t ps2HostEeCycles()
+{
+    static const auto start = std::chrono::steady_clock::now();
+    const uint64_t ns = static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+    return static_cast<uint32_t>(ns * 36864u / 125000u); // ns * 0.294912
+}
+
+inline uint32_t ps2ReadCop0Count(const R5900Context *ctx)
+{
+    return ctx->cop0_count + ps2HostEeCycles();
+}
+
+inline void ps2WriteCop0Count(R5900Context *ctx, uint32_t value)
+{
+    ctx->cop0_count = value - ps2HostEeCycles();
+}
