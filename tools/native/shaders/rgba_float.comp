#version 450
// Converts between the frame as packed RGBA8 (r = bits 0-7) and float RGBA planes (0..255) for the
// ColorDiffusion kernels. op 0: frame -> colour plane (dst) and alpha plane (aux, alpha in rgb);
// op 1: colour plane (src) -> frame RGB (truncated, clamped), the frame's alpha kept.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Frame { uint frame[]; };
layout(std430, binding = 1) buffer Plane { vec4 plane[]; };
layout(std430, binding = 2) buffer Alpha { vec4 alphaPlane[]; };
layout(push_constant) uniform Push
{
    int op;
    int w, h;
} p;

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= p.w || pix.y >= p.h)
        return;
    int i = pix.y * p.w + pix.x;
    uint t = frame[i];
    if (p.op == 0)
    {
        plane[i] = vec4(float(t & 0xFFu), float((t >> 8) & 0xFFu), float((t >> 16) & 0xFFu), 0.0);
        float a = float(t >> 24);
        alphaPlane[i] = vec4(a, a, a, 0.0);
    }
    else
    {
        uvec3 c = uvec3(clamp(plane[i].rgb, vec3(0.0), vec3(255.0)));
        frame[i] = c.r | (c.g << 8) | (c.b << 16) | (t & 0xFF000000u);
    }
}
